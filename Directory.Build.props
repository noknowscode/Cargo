<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>

    <!--
      Build gate: a compiler, analyzer or code-style warning (.editorconfig) fails the build, so the 0-warning state
      holds by itself. Uno0001 (an API Uno does not implement on a head) is one of them: a silent no-op is a bug.
      Trim analysis stays a warning: on the WebAssembly, WinAppSDK and iOS heads it reports code the XAML generator
      writes (IL2026) and the trimmer's report on framework and Uno assemblies (IL2104, IL2121), not code this repo can change.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>
    <!-- NuGet audit stays a warning: a newly published advisory, or an unreachable audit source, must not fail a build of unchanged code. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2104;IL2121</WarningsNotAsErrors>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
