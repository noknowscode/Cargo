<Application x:Class="UnoOrbit.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Content items MUST come before property elements (MergedDictionaries) -->

      <!-- Font families -->
      <FontFamily x:Key="SyneFont">ms-appx:///Assets/Fonts/Syne-VariableFont_wght.ttf#Syne</FontFamily>
      <FontFamily x:Key="SpaceMonoFont">ms-appx:///Assets/Fonts/SpaceMono-Regular.ttf#Space Mono</FontFamily>
      <FontFamily x:Key="SpaceMonoBoldFont">ms-appx:///Assets/Fonts/SpaceMono-Bold.ttf#Space Mono</FontFamily>

      <!-- Color tokens -->
      <Color x:Key="OrbitBackground">#04060e</Color>
      <Color x:Key="OrbitText">#e8e6f0</Color>
      <Color x:Key="OrbitSurface">#0Affffff</Color>
      <Color x:Key="OrbitSurfaceBorder">#10ffffff</Color>

      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
