<UserControl x:Class="UnoOrbit.Components.ZoomIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="100"
            Background="#0Affffff"
            BorderBrush="#10ffffff"
            BorderThickness="1"
            Padding="16,6">
        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
            <Button x:Name="ZoomInButton"
                    Content="+"
                    Click="OnZoomIn"
                    Width="28" Height="28"
                    CornerRadius="8"
                    Background="#10ffffff"
                    BorderBrush="#1Affffff"
                    BorderThickness="1"
                    Foreground="#e8e6f0"
                    FontFamily="{StaticResource SyneFont}"
                    FontSize="18.4"
                    FontWeight="Light"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" />
            <TextBlock x:Name="ZoomLevelText"
                       Text="1.0×"
                       FontFamily="{StaticResource SpaceMonoFont}"
                       FontSize="12"
                       Foreground="#e8e6f0"
                       Opacity="0.5"
                       MinWidth="30"
                       TextAlignment="Center"
                       VerticalAlignment="Center" />
            <Button x:Name="ZoomOutButton"
                    Content="−"
                    Click="OnZoomOut"
                    Width="28" Height="28"
                    CornerRadius="8"
                    Background="#10ffffff"
                    BorderBrush="#1Affffff"
                    BorderThickness="1"
                    Foreground="#e8e6f0"
                    FontFamily="{StaticResource SyneFont}"
                    FontSize="18.4"
                    FontWeight="Light"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
