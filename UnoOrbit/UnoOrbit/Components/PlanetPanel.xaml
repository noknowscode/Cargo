<UserControl x:Class="UnoOrbit.Components.PlanetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Bottom">
    <Border x:Name="PanelRoot"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelTranslate" Y="800" />
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                <GradientStop Color="#F804060e" Offset="0" />
                <GradientStop Color="#F804060e" Offset="0.6" />
                <GradientStop Color="#0004060e" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          MaxHeight="500">
                <StackPanel>
                    <!-- Handle -->
                    <StackPanel x:Name="HandleArea"
                                HorizontalAlignment="Stretch"
                                Padding="0,16"
                                Background="Transparent"
                                PointerPressed="OnHandleTapped">
                        <Border Width="36" Height="3"
                                CornerRadius="2"
                                Background="#33ffffff"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Content -->
                    <StackPanel Padding="32,0,32,40">
                        <!-- Planet name -->
                        <TextBlock x:Name="PlanetNameText"
                                   FontFamily="{StaticResource SyneFont}"
                                   FontWeight="ExtraBold"
                                   FontSize="46"
                                   CharacterSpacing="-30"
                                   Margin="0,0,0,4.8"
                                   IsTextSelectionEnabled="False" />

                        <!-- Type line -->
                        <TextBlock x:Name="TypeLineText"
                                   FontFamily="{StaticResource SyneFont}"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   CharacterSpacing="200"
                                   Foreground="#e8e6f0"
                                   Opacity="0.35"
                                   Margin="0,0,0,24"
                                   IsTextSelectionEnabled="False" />

                        <!-- Stats grid -->
                        <Grid x:Name="StatsGrid" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>

                        <!-- Fun fact -->
                        <Border x:Name="FunFactCard"
                                CornerRadius="14"
                                Background="#08ffffff"
                                BorderBrush="#0Dffffff"
                                BorderThickness="1"
                                Padding="16,16,19.2,16"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="FunFactTranslate" Y="15" />
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" Spacing="12.8">
                                <TextBlock x:Name="FactIconText"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           IsTextSelectionEnabled="False" />
                                <TextBlock x:Name="FactText"
                                           FontFamily="{StaticResource SyneFont}"
                                           FontSize="14.7"
                                           Foreground="#e8e6f0"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           LineHeight="19.2"
                                           VerticalAlignment="Center"
                                           IsTextSelectionEnabled="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
