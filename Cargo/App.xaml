<Application x:Class="Cargo.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utus="using:Uno.Toolkit.UI.Simple"
             xmlns:utu="using:Uno.Toolkit.UI"
       RequestedTheme="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utus:SimpleToolkitTheme />
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/MotionTokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The app's size classes, for every {utu:Responsive} that names no Layout:
           phone under 600, tablet 600, tablet landscape and small laptop 1000, desktop 1280 -->
      <utu:ResponsiveLayout x:Key="DefaultResponsiveLayout" Narrowest="0" Narrow="600" Normal="1000" Wide="1280" Widest="1600" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
