<Page x:Class="Cargo.Presentation.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:liveline="using:Liveline">

  <!-- Overview bands (App.xaml's size classes): from 1280 the design's 8 + 4; 1000-1279 7 + 5; below 1000 the aside
       drops below the timeline and Activity is one column; below 600 the timeline's figures move above its lanes.
       Main: max 1440 with 32/40/56 padding (the design's frame, not PageFrame's) -->
  <Grid Style="{StaticResource PageFrame}" MinWidth="0" MaxWidth="1440" RowSpacing="{StaticResource Space24}"
        Padding="{utu:Responsive Narrowest={StaticResource PagePaddingPhone}, Narrow={StaticResource PagePaddingTablet}, Normal='40,32,40,56'}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Row 0: the day's timeline (span 8) + the aside (span 4) on the design's 12-column grid ── -->
    <Grid Grid.Row="0" ColumnSpacing="{StaticResource Space24}" RowSpacing="{StaticResource Space24}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Today at North Quay: four lanes on one time axis, or the same hours as a table. It stretches
           to the row so its bottom meets the aside's (Needs you + Next 6 h) when they sit side by side -->
      <utu:CardContentControl AutomationProperties.Name="Today at North Quay" x:Name="FirstSection" Grid.ColumnSpan="{utu:Responsive Narrowest=12, Normal=7, Wide=8}"
                              Style="{StaticResource OutlinedPanel}" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                              Padding="{utu:Responsive Narrowest={StaticResource Inset16}, Narrow={StaticResource Inset24}}">
        <StackPanel Spacing="{StaticResource Space16}">
          <!-- On a phone the Chart / Table toggle drops under the title -->
          <Grid ColumnSpacing="{StaticResource Space16}" RowSpacing="{StaticResource Space12}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="{StaticResource Space4}">
              <TextBlock Text="Today at North Quay" Style="{StaticResource PanelHeadingText}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="Wed 06:00 → Thu 06:00 · live" Style="{StaticResource SubtitleText}" />
            </StackPanel>
            <!-- Chart / Table: an ink pill slides between the two (SegmentIndicator) -->
            <!-- xaml-lint: allow card - the toggle's ring, a 1px inset outline around two segments -->
            <Border Grid.Row="{utu:Responsive Narrowest=1, Narrow=0}" Grid.Column="{utu:Responsive Narrowest=0, Narrow=1}"
                    HorizontalAlignment="Left" Padding="{StaticResource Inset2}" CornerRadius="{StaticResource RadiusGroup}" BorderThickness="1" VerticalAlignment="Top"
                    BorderBrush="{ThemeResource HairlineStrongBrush}">
              <Grid>
                <controls:SegmentIndicator Host="{x:Bind ViewToggle}" SelectedIndex="{x:Bind ViewModel.Timeline.ViewIndex, Mode=OneWay}"
                                           Height="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource InkBrush}" />
                <StackPanel x:Name="ViewToggle" Orientation="Horizontal">
                  <Button AutomationProperties.Name="Chart" Content="Chart" Style="{StaticResource ToggleSegmentButton}" Height="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" Command="{x:Bind ViewModel.Timeline.ShowChartCommand, Mode=OneWay}"
                          Foreground="{x:Bind local:OverviewView.ChartInk(ViewModel.Timeline.IsTable), Mode=OneWay}" />
                  <Button AutomationProperties.Name="Table" Content="Table" Style="{StaticResource ToggleSegmentButton}" Height="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" Command="{x:Bind ViewModel.Timeline.ShowTableCommand, Mode=OneWay}"
                          Foreground="{x:Bind local:OverviewView.TableInk(ViewModel.Timeline.IsTable), Mode=OneWay}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <controls:FlowPanel AutomationProperties.Name="Timeline legend" Spacing="{StaticResource Space20}" RowSpacing="{StaticResource Space8}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"><Ellipse Width="10" Height="10" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" /><TextBlock Text="Happened" Style="{StaticResource SubtitleText}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"><Ellipse Width="10" Height="10" Stroke="{ThemeResource NavyBrush}" StrokeThickness="1.6" VerticalAlignment="Center" /><TextBlock Text="Planned" Style="{StaticResource SubtitleText}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"><Rectangle Width="16" Height="12" Fill="{ThemeResource HairlineBrush}" VerticalAlignment="Center" /><TextBlock Text="Ahead of now" Style="{StaticResource SubtitleText}" /></StackPanel>
          </controls:FlowPanel>

          <StackPanel Spacing="{StaticResource Space16}" Visibility="{x:Bind local:Paint.Unless(ViewModel.Timeline.IsTable), Mode=OneWay}">
          <!-- Phones: the four lanes' figures above the chart, two by two, so the lanes get the whole width;
               the summary column keeps only the lane names. Hidden from automation, like the column: the lanes'
               own name reads the same figures once. Raw on a panel hides only the panel, so every text is Raw too -->
          <controls:TileGridPanel MinTileWidth="120" Gap="16" AutomationProperties.AccessibilityView="Raw"
                                  Visibility="{utu:Responsive Narrowest=Visible, Narrow=Collapsed}">
            <StackPanel Spacing="{StaticResource Space2}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" /><TextBlock AutomationProperties.AccessibilityView="Raw" Text="VESSELS" Style="{StaticResource CapsLabelText}" /></StackPanel>
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.VesselsValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="{StaticResource GapTop6}" />
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.VesselsSub, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space2}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource WaterBrush}" VerticalAlignment="Center" /><TextBlock AutomationProperties.AccessibilityView="Raw" Text="TIDE" Style="{StaticResource CapsLabelText}" /></StackPanel>
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.TideValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="{StaticResource GapTop6}" />
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.TideSub, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space2}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" /><TextBlock AutomationProperties.AccessibilityView="Raw" Text="MOVES" Style="{StaticResource CapsLabelText}" /></StackPanel>
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.MovesValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="{StaticResource GapTop6}" />
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.MovesPeak, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space2}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" /><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource WaterBrush}" VerticalAlignment="Center" /><TextBlock AutomationProperties.AccessibilityView="Raw" Text="CARGO" Style="{StaticResource CapsLabelText}" /></StackPanel>
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.CargoValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="{StaticResource GapTop6}" />
              <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.CargoSub, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
          </controls:TileGridPanel>

          <!-- Chart: the lanes canvas, the tide lane over its band, the summary column over x 0-168 -->
          <Grid Height="580">
            <controls:TimelineLanes Frame="{x:Bind ViewModel.Timeline.Frame, Mode=OneWay}"
                                    PlotLeft="{utu:Responsive Narrowest=0, Narrow=168}"
                                    HoverCommand="{x:Bind ViewModel.State.Stage.HoverCommand}"
                                    Lit="{x:Bind ViewModel.State.Stage.HoveredVessel, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.Timeline.Summary, Mode=OneWay}"
                                    AutomationProperties.LiveSetting="Polite" />
            <!-- Tide: y = 284 - 35 m in the design, so the band 164-300 holds 0 to 3.43 m over 16 px of floor -->
            <liveline:LivelineChart AutomationProperties.Name="{x:Bind ViewModel.Timeline.TideSub, Mode=OneWay}" x:Name="TideLane" Margin="{utu:Responsive Narrowest='0,164,12,0', Narrow='168,164,12,0'}" Height="136" VerticalAlignment="Top"
                                    WindowStart="{x:Bind ViewModel.Timeline.WindowStart, Mode=OneWay}"
                                    WindowEnd="{x:Bind ViewModel.Timeline.WindowEnd, Mode=OneWay}"
                                    NowTime="{x:Bind ViewModel.Timeline.NowTime, Mode=OneWay}"
                                    Data="{x:Bind ViewModel.Timeline.TidePast, Mode=OneWay}"
                                    Forecast="{x:Bind ViewModel.Timeline.TideAhead, Mode=OneWay}"
                                    Markers="{x:Bind local:OverviewView.TideMarkers(ViewModel.Timeline.Tide), Mode=OneWay}"
                                    LerpSpeed="{x:Bind local:OverviewView.TideLerp(ViewModel.NowHours), Mode=OneWay}"
                                    ChartBackground="Transparent" LineBrush="{ThemeResource WaterBrush}"
                                    FillTopBrush="{ThemeResource TideFillTopBrush}" FillBottomBrush="{ThemeResource TideFillBottomBrush}"
                                    LabelHaloBrush="{ThemeResource SurfaceBrush}" LabelBrush="{ThemeResource TextFaintBrush}"
                                    GridLineBrush="{ThemeResource HairlineBrush}" BadgeTextBrush="{ThemeResource OnAccentBrush}"
                                    ForecastOpacity="0.5" StrokeThickness="2" PlotPadding="0,0,0,16" ValueMin="0" ValueMax="3.4286"
                                    ShowGrid="False" ShowBadge="False" ShowTrackingLine="False" Momentum="False"
                                    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <!-- The summary column: hidden from automation text by text (the lanes' name reads its figures) -->
            <Grid Width="160" HorizontalAlignment="Left" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
              <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="136" />
                <RowDefinition Height="136" />
                <RowDefinition Height="128" />
                <RowDefinition Height="112" />
              </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Spacing="{StaticResource Space2}" Padding="{StaticResource GapTop4}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="VESSELS" Style="{StaticResource CapsLabelText}" Margin="0,0,0,0" />
              </StackPanel>
              <StackPanel Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}">
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.VesselsValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="0,8,0,2" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.VesselsSub, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="arrivals ↑ departures ↓" Style="{StaticResource CaptionText}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="{StaticResource Space2}" Padding="{StaticResource GapTop4}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource WaterBrush}" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="TIDE" Style="{StaticResource CapsLabelText}" Margin="0,0,0,0" />
              </StackPanel>
              <StackPanel Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}">
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.TideValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="0,8,0,2" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.TideSub, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="wind 14 kn SW" Style="{StaticResource CaptionText}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="3" Spacing="{StaticResource Space2}" Padding="{StaticResource GapTop4}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="MOVES" Style="{StaticResource CapsLabelText}" Margin="0,0,0,0" />
              </StackPanel>
              <StackPanel Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}">
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.MovesValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="0,8,0,2" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="per hour, 06:00 → now" Style="{StaticResource CaptionText}" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.MovesPeak, Mode=OneWay}" Style="{StaticResource CaptionText}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="4" Spacing="{StaticResource Space2}" Padding="{StaticResource GapTop4}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" /><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource WaterBrush}" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="CARGO" Style="{StaticResource CapsLabelText}" Margin="0,0,0,0" />
              </StackPanel>
              <StackPanel Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}">
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.CargoValue, Mode=OneWay}" Style="{StaticResource TypeStrong20}" Foreground="{ThemeResource InkBrush}" Margin="0,8,0,2" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.CargoSub, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ViewModel.Timeline.CargoSince, Mode=OneWay}" Style="{StaticResource CaptionText}" />
              </StackPanel>
            </StackPanel>
            </Grid>
          </Grid>
          </StackPanel>

          <!-- Table: the same day hour by hour, the chart's full non-visual alternative. Its seven columns need 600 px:
               narrower (a phone, or the 7-of-12 band from 1000 to 1279) it scrolls sideways inside the card -->
          <!-- Below 1280 the table keeps 600 px and scrolls sideways in its card; from 1280 it takes the card's width and the
               vessels column trims, so a long hour never pushes NET / H past the card's edge -->
          <ScrollViewer AutomationProperties.Name="Today at North Quay, by the hour" Visibility="{x:Bind ViewModel.Timeline.IsTable, Mode=OneWay}"
                        HorizontalScrollMode="{utu:Responsive Narrowest=Auto, Wide=Disabled}"
                        HorizontalScrollBarVisibility="{utu:Responsive Narrowest=Auto, Wide=Disabled}"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
          <StackPanel MinWidth="600" Padding="{StaticResource GapBottom8}">
            <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource InsetX8}" Height="32">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" />
                <ColumnDefinition Width="92" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="72" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="TIME" Style="{StaticResource CapsLabelText}" VerticalAlignment="Center" />
              <Grid Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Left"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" /><TextBlock Text="VESSELS" Style="{StaticResource CapsLabelText}" /></StackPanel></Grid>
              <Grid Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Right"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource WaterBrush}" VerticalAlignment="Center" /><TextBlock Text="TIDE M" Style="{StaticResource CapsLabelText}" /></StackPanel></Grid>
              <Grid Grid.Column="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Right"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" /><TextBlock Text="MOVES / H" Style="{StaticResource CapsLabelText}" /></StackPanel></Grid>
              <Grid Grid.Column="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Right"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" /><TextBlock Text="IN / H" Style="{StaticResource CapsLabelText}" /></StackPanel></Grid>
              <Grid Grid.Column="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Right"><Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource WaterBrush}" VerticalAlignment="Center" /><TextBlock Text="OUT / H" Style="{StaticResource CapsLabelText}" /></StackPanel></Grid>
              <Grid Grid.Column="6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Right"><TextBlock Text="NET / H" Style="{StaticResource CapsLabelText}" /></StackPanel></Grid>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline.Rows, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:TimelineRow">
                  <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource InsetX8}" MinHeight="28"
                        Background="{x:Bind local:OverviewView.RowGround(IsFuture), Mode=OneWay}"
                        BorderBrush="{x:Bind local:OverviewView.RowRule(IsNow), Mode=OneWay}"
                        BorderThickness="{x:Bind local:OverviewView.RowRuleWidth(IsNow), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" />
                      <ColumnDefinition Width="92" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Vessels}" Style="{StaticResource TypeBody13}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Tide}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Moves, Mode=OneWay}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{x:Bind In, Mode=OneWay}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{x:Bind Out, Mode=OneWay}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{x:Bind Net, Mode=OneWay}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Padding="8,12,8,0" ColumnSpacing="{StaticResource Space16}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Hourly values; the NOW row is live. Ahead of now: tide is the tide-table forecast, moves and cargo have no forecast."
                         Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Timeline.MovesTotal, Mode=OneWay}" Style="{StaticResource TypeMono12}"
                         Foreground="{ThemeResource TextMutedBrush}" />
            </Grid>
          </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </utu:CardContentControl>

      <!-- Aside: the Needs-you queue bleeding to the card's edges, a full-bleed rule, then what's next -->
      <utu:CardContentControl AutomationProperties.Name="Next 6 hours" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"
                              Grid.Column="{utu:Responsive Narrowest=0, Normal=7, Wide=8}"
                              Grid.ColumnSpan="{utu:Responsive Narrowest=12, Normal=5, Wide=4}"
                              Style="{StaticResource OutlinedPanel}" Padding="0"
                              VerticalAlignment="Top">
        <StackPanel>
          <local:NeedsYouPanel x:Name="NeedsYou" DataContext="{x:Bind ViewModel.State}" />
          <Rectangle Height="1" Fill="{ThemeResource HairlineStrongBrush}" />
          <StackPanel Spacing="{StaticResource Space14}" Padding="{StaticResource Inset24}">
          <!-- Next 6 h: from 15 minutes back to six hours ahead, the NOW row between what has
               happened and what is to come, each ship drawn to scale -->
          <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Text="Next 6 h" Style="{StaticResource PanelHeadingText}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{x:Bind ViewModel.NextSix.Sub, Mode=OneWay}" Style="{StaticResource SubtitleText}" />
          </StackPanel>
          <TextBlock Text="No movements in the next 6 h" Style="{StaticResource SubtitleText}"
                     Visibility="{x:Bind ViewModel.NextSix.IsEmpty, Mode=OneWay}" />
          <Grid>
            <!-- The rail through the dots (x 60: the 44 time column, a 12 gap, half the 10 dot) -->
            <Rectangle Width="1" HorizontalAlignment="Left" Margin="60,0,0,0" Fill="{ThemeResource HairlineStrongBrush}" />
            <StackPanel>
              <ItemsControl AutomationProperties.Name="Movements so far" ItemsSource="{x:Bind ViewModel.NextSix.Past, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NextSixRow">
                  <!-- The row opens the vessel; hover or keyboard focus lights it on the map and the chart.
                       The tint bleeds 12 px past the column. -->
                  <Button Style="{StaticResource RowButton}" Command="{x:Bind Open}" CommandParameter="{x:Bind Id}"
                          Margin="-12,0" Padding="0" CornerRadius="{StaticResource RadiusControl}"
                          controls:HoverLink.Command="{x:Bind Hover}" controls:HoverLink.Key="{x:Bind Id}"
                          AutomationProperties.Name="{x:Bind local:OverviewView.SixName(Name, Sub, Countdown), Mode=OneWay}">
                  <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource Inset12x10}" CornerRadius="{StaticResource RadiusControl}" Background="{x:Bind local:OverviewView.LinkGround(IsLinked), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource TypeMonoMedium13}" Foreground="{ThemeResource InkBrush}" />
                    <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top" Margin="{StaticResource GapTop6}"
                             Fill="{x:Bind local:OverviewView.DotFill(Happened), Mode=OneWay}" Stroke="{x:Bind local:OverviewView.DotRing(Happened), Mode=OneWay}" StrokeThickness="{x:Bind local:OverviewView.DotRingWidth(Happened), Mode=OneWay}" />
                    <StackPanel Grid.Column="2" Spacing="{StaticResource Space2}">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource TitleText}" />
                      <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="{StaticResource Space6}" HorizontalAlignment="Right">
                      <TextBlock Text="{x:Bind Countdown, Mode=OneWay}" Style="{StaticResource TypeMonoMedium13}" HorizontalAlignment="Right"
                                 Foreground="{x:Bind local:OverviewView.CountdownInk(IsSoon), Mode=OneWay}" />
                      <controls:ShipGlyph Length="{x:Bind Length}" Seed="{x:Bind Id}" Departing="{x:Bind Departing, Mode=OneWay}"
                                          HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  </Button>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- NOW: the pill over the time column, a 1.25 ink line across -->
              <Grid Height="14" ColumnSpacing="{StaticResource Space12}" AutomationProperties.Name="Now">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- xaml-lint: allow card - the NOW pill, a 14 px ink capsule -->
                <Border Background="{ThemeResource InkBrush}" CornerRadius="7">
                  <TextBlock Text="NOW" Style="{StaticResource TypeMonoMedium11}" Foreground="{ThemeResource PaperBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle Grid.Column="1" Height="1.25" Fill="{ThemeResource InkBrush}" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl AutomationProperties.Name="Movements ahead" ItemsSource="{x:Bind ViewModel.NextSix.Upcoming, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NextSixRow">
                  <!-- The row opens the vessel; hover or keyboard focus lights it on the map and the chart.
                       The tint bleeds 12 px past the column. -->
                  <Button Style="{StaticResource RowButton}" Command="{x:Bind Open}" CommandParameter="{x:Bind Id}"
                          Margin="-12,0" Padding="0" CornerRadius="{StaticResource RadiusControl}"
                          controls:HoverLink.Command="{x:Bind Hover}" controls:HoverLink.Key="{x:Bind Id}"
                          AutomationProperties.Name="{x:Bind local:OverviewView.SixName(Name, Sub, Countdown), Mode=OneWay}">
                  <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource Inset12x10}" CornerRadius="{StaticResource RadiusControl}" Background="{x:Bind local:OverviewView.LinkGround(IsLinked), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource TypeMonoMedium13}" Foreground="{ThemeResource InkBrush}" />
                    <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top" Margin="{StaticResource GapTop6}"
                             Fill="{x:Bind local:OverviewView.DotFill(Happened), Mode=OneWay}" Stroke="{x:Bind local:OverviewView.DotRing(Happened), Mode=OneWay}" StrokeThickness="{x:Bind local:OverviewView.DotRingWidth(Happened), Mode=OneWay}" />
                    <StackPanel Grid.Column="2" Spacing="{StaticResource Space2}">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource TitleText}" />
                      <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="{StaticResource Space6}" HorizontalAlignment="Right">
                      <TextBlock Text="{x:Bind Countdown, Mode=OneWay}" Style="{StaticResource TypeMonoMedium13}" HorizontalAlignment="Right"
                                 Foreground="{x:Bind local:OverviewView.CountdownInk(IsSoon), Mode=OneWay}" />
                      <controls:ShipGlyph Length="{x:Bind Length}" Seed="{x:Bind Id}" Departing="{x:Bind Departing, Mode=OneWay}"
                                          HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  </Button>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
          </StackPanel>
        </StackPanel>
      </utu:CardContentControl>
    </Grid>

    <!-- ── Row 1: the shift log ─────────────────────────────────── -->
    <local:ActivityView Grid.Row="1" DataContext="{x:Bind ViewModel.Activity, Mode=OneWay}" />
  </Grid>
</Page>
