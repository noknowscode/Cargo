<UserControl x:Class="Cargo.Presentation.ContainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <!-- The explorer: the cards beside the selected box from 1000 px, the box under the cards below it; the filter chips
       beside the title from 1280, under it below (wrapping on a phone) -->
  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="{StaticResource Space20}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="{StaticResource Space4}">
        <TextBlock Text="Containers" Style="{StaticResource SectionHeadText}" />
        <TextBlock Text="Find a box, follow its journey, release or inspect a hold" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
      </StackPanel>
      <ItemsControl AutomationProperties.Name="Container filters" ItemsSource="{x:Bind ViewModel.Filters, Mode=OneWay}" VerticalAlignment="Bottom" IsTabStop="False"
                    Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                    Margin="{utu:Responsive Narrowest={StaticResource GapTop10}, Wide='0'}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><controls:FlowPanel Spacing="{StaticResource Space6}" RowSpacing="{StaticResource Space2}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:FilterChip">
            <!-- The pill stays 30 px; below 1000 the button around it is the 44 px touch target -->
            <Button Style="{StaticResource BareButton}" Command="{x:Bind Apply}" CommandParameter="{x:Bind Label}"
                    MinHeight="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource TouchTarget}, Normal=0}"
                    AutomationProperties.Name="{x:Bind AccessibleName}">
              <!-- xaml-lint: allow card - a filter pill, not a card; half-height radius (99 draws an oval on Skia) -->
              <Border Background="{x:Bind local:ContainersView.ChipGround(IsCurrent)}" BorderBrush="{x:Bind local:ContainersView.ChipEdge(IsCurrent)}" BorderThickness="1"
                      CornerRadius="15" Padding="13,7" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource TypeMedium12}"
                           Foreground="{x:Bind local:ContainersView.ChipInk(IsCurrent)}" />
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Empty: a filter that matches nothing says so, and how to get every box back -->
      <StackPanel Spacing="{StaticResource Space12}" Padding="{StaticResource InsetY24}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
        <Button AutomationProperties.Name="Show all containers" Style="{StaticResource GhostButton}" Content="Show all containers" HorizontalAlignment="Left"
                MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}"
                Command="{x:Bind ViewModel.FilterCommand}" CommandParameter="All" />
      </StackPanel>

      <ItemsControl AutomationProperties.Name="Containers" ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}" VerticalAlignment="Top" IsTabStop="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:TileGridPanel MinTileWidth="240" Gap="14" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ContainerCard">
            <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}"
                    AutomationProperties.Name="{x:Bind AccessibleName}">
              <utu:CardContentControl Style="{StaticResource OutlinedPanel}" BorderBrush="{x:Bind local:Paint.SelectedEdge(IsSelected)}" Padding="{StaticResource Inset16x14}">
                <StackPanel Spacing="{StaticResource Space6}">
                  <Grid>
                    <!-- xaml-lint: allow card - the image well inside a container card -->
                    <Border CornerRadius="{StaticResource RadiusGroup}" Padding="6,8,6,4">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Offset="0" Color="{ThemeResource SurfaceColor}" />
                          <GradientStop Offset="1" Color="{ThemeResource SeaLightColor}" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Image Source="{x:Bind local:Paint.Sprite(Render)}" Height="72" Stretch="Uniform" />
                    </Border>
                    <!-- xaml-lint: allow card - container id tag over the image -->
                    <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource RadiusTag}" Padding="7,2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{StaticResource Inset10}">
                      <TextBlock Text="{x:Bind IdPretty}" Style="{StaticResource TypeMonoMedium12}" />
                    </Border>
                    <!-- xaml-lint: allow card - size and carrier tag over the image -->
                    <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource RadiusTag}" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,10,8">
                      <TextBlock Text="{x:Bind Meta}" Style="{StaticResource TypeMonoMedium11}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{x:Bind Route}" Style="{StaticResource BodyStrongText}"
                             TextTrimming="CharacterEllipsis" Margin="{StaticResource GapTop4}" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <Ellipse Width="7" Height="7" Fill="{x:Bind local:ContainersView.StateFill(Warn)}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind State}" Style="{StaticResource BodySmallText}"
                               Foreground="{x:Bind local:ContainersView.StateInk(Warn)}" />
                  </StackPanel>
                </StackPanel>
              </utu:CardContentControl>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── Selected container ───────────────────────────────── -->
      <utu:CardContentControl AutomationProperties.Name="Selected container" Style="{StaticResource PanelCard}" Padding="{utu:Responsive Narrowest={StaticResource Inset16}, Narrow={StaticResource Inset22x20}}" VerticalAlignment="Top"
                              Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                              Width="{utu:Responsive Narrowest=NaN, Normal=340, Wide=360}"
                              Margin="{utu:Responsive Narrowest={StaticResource GapTop18}, Normal={StaticResource GapStart18}}">
        <StackPanel Spacing="{StaticResource Space16}">
          <StackPanel Spacing="{StaticResource Space6}">
            <TextBlock Text="{x:Bind ViewModel.SelectedId, Mode=OneWay}" Style="{StaticResource TypeMonoMedium20}" />
            <TextBlock Text="{x:Bind ViewModel.SelectedMeta, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Image Source="{x:Bind local:Paint.Sprite(ViewModel.SelectedIso), Mode=OneWay}" Height="150" Stretch="Uniform" />

          <StackPanel Spacing="{StaticResource Space10}">
            <TextBlock Text="JOURNEY" Style="{StaticResource TypeStrong12}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            <ItemsControl IsTabStop="False" AutomationProperties.Name="Container journey" ItemsSource="{x:Bind ViewModel.Journey, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:EvenRowPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JourneyStep">
                  <Grid ColumnSpacing="{StaticResource Space4}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource Space6}" HorizontalAlignment="Center">
                      <!-- xaml-lint: allow card - journey step icon disc -->
                      <Border Width="30" Height="30" CornerRadius="15" Background="{x:Bind local:ContainersView.StepGround(State)}"
                              BorderBrush="{x:Bind local:ContainersView.StepEdge(State)}" BorderThickness="1.5">
                        <shapes:Path Data="{x:Bind local:Paint.Icon(IconData)}" Stroke="{x:Bind local:ContainersView.StepIconInk(State)}" StrokeThickness="1.8"
                                     Width="15" Height="15" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource TypeMedium11}"
                                 Foreground="{x:Bind local:ContainersView.StepInk(State)}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Rectangle Grid.Column="1" Height="1.5" Fill="{x:Bind local:ContainersView.StepLine(State, IsLast)}" Margin="4,0,4,20"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
          <ItemsControl IsTabStop="False" AutomationProperties.Name="Container facts" ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="{StaticResource Space14}" RowSpacing="{StaticResource Space12}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="{StaticResource Space4}">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongText}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Style="{StaticResource PrimaryButton}" Command="{x:Bind ViewModel.OpenScannerCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Scan container"
                  MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Center">
              <shapes:Path Data="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M3 12h18"
                           Stroke="{ThemeResource OnSurfaceInverseBrush}" StrokeThickness="2" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                           Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="Scan container" Style="{StaticResource TypeMedium13}"
                         Foreground="{ThemeResource OnSurfaceInverseBrush}" />
            </StackPanel>
          </Button>
          <!-- Security's inspection record is the held box's: only she offers it -->
          <Button AutomationProperties.Name="Open inspection" Style="{StaticResource GhostButton}" Content="Open inspection →"
                  MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}" Visibility="{x:Bind ViewModel.IsHeld, Mode=OneWay}"
                  Command="{x:Bind ViewModel.State.Navigation.OpenInspectionCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </utu:CardContentControl>
    </Grid>
  </Grid>
</UserControl>
