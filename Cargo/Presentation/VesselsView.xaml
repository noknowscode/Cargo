<UserControl x:Class="Cargo.Presentation.VesselsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <!-- The vessel you are working. From 1280 the design's three columns (vessels, profile and operations, voyage);
       1000-1279 the voyage drops under the other two; below 1000 one column, the vessels two or three to a row -->
  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="{StaticResource Space4}">
      <TextBlock Text="{x:Bind ViewModel.VesselName, Mode=OneWay}" Style="{StaticResource SectionHeadText}" />
      <TextBlock Text="{x:Bind ViewModel.Eyebrow, Mode=OneWay}" Style="{StaticResource CaptionText}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{utu:Responsive Narrowest=0, Normal=240}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{utu:Responsive Narrowest=0, Wide=290}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── Vessels in port ────────────────────────────────────── -->
      <StackPanel Spacing="{StaticResource Space10}" Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1}">
        <ItemsControl AutomationProperties.Name="Vessels in port" ItemsSource="{x:Bind ViewModel.Vessels, Mode=OneWay}" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><controls:TileGridPanel MinTileWidth="220" Gap="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:VesselRow">
              <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}"
                      AutomationProperties.Name="{x:Bind Name}">
                <utu:CardContentControl Style="{StaticResource OutlinedPanel}" BorderBrush="{x:Bind local:VesselsView.RowEdge(IsSelected)}" BorderThickness="1.5" Padding="{StaticResource Inset14}">
                  <Grid ColumnSpacing="{StaticResource Space10}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource Space6}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind local:Paint.Tone(Tone)}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource TypeStrong13}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Text="{x:Bind Line1, Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapStart16}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Line2, Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapStart16}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="{x:Bind local:Paint.Sprite(Silhouette)}" Width="84" Height="30"
                           Stretch="Uniform" VerticalAlignment="Center" />
                  </Grid>
                </utu:CardContentControl>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.State.OpenDockingCommand}"
                AutomationProperties.Name="View all in Docking"
                Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource RadiusPanel}" Padding="{StaticResource Inset16x12}"
                MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Grid>
            <TextBlock Text="View all in Docking" Style="{StaticResource LabelMedium}" />
            <TextBlock Text="↗" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Right"
                       AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </Button>
      </StackPanel>

      <!-- ── Profile and operations ─────────────────────────────── -->
      <StackPanel Spacing="{StaticResource Space16}"
                  Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                  Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=2, Wide=1}"
                  Margin="{utu:Responsive Narrowest={StaticResource GapTop16}, Normal={StaticResource GapStart16}}">
        <utu:CardContentControl AutomationProperties.Name="{x:Bind ViewModel.VesselName, Mode=OneWay}" Style="{StaticResource PanelCard}" Padding="{utu:Responsive Narrowest='16,16,16,14', Narrow='22,18,22,14'}">
          <StackPanel Spacing="{StaticResource Space14}">
            <StackPanel Spacing="{StaticResource Space4}">
              <!-- The selected bay's line sits beside the title from 1280, under it below -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="{StaticResource Space4}">
                  <TextBlock Text="Side profile" Style="{StaticResource CardTitleText}" />
                  <TextBlock Text="{x:Bind ViewModel.ProfileHint, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.BayLabel, Mode=OneWay}" Style="{StaticResource BodyStrongSmallText}"
                           Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Top" TextWrapping="Wrap"
                           Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                           Margin="{utu:Responsive Narrowest={StaticResource GapTop6}, Wide={StaticResource GapStart16}}" />
              </Grid>
              <ContentControl x:Name="ProfileHost" HorizontalContentAlignment="Stretch" Margin="{StaticResource GapTop4}" IsTabStop="False" />
              <ItemsControl AutomationProperties.Name="Cargo legend" ItemsSource="{x:Bind ViewModel.CargoLegend, Mode=OneWay}" Margin="0,10,0,2" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><controls:FlowPanel Spacing="{StaticResource Space18}" RowSpacing="{StaticResource Space6}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:LegendItem">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                      <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource RadiusMark}" RadiusY="{StaticResource RadiusMark}" Fill="{x:Bind local:Paint.Swatch(Swatch, Strength)}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Key figures under the profile, four across where they fit. The design floated them over the water at
                 the bow, but up to the page's 1520 cap that water is narrower than the cards and they covered the
                 first bays (clickable columns) -->
            <ItemsControl AutomationProperties.Name="Vessel figures" ItemsSource="{x:Bind ViewModel.MiniCards, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:TileGridPanel MinTileWidth="128" Gap="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:MiniCard">
                  <utu:CardContentControl Style="{StaticResource OutlinedPanel}" Background="{ThemeResource BackgroundBrush}" Padding="12,10,12,9">
                    <StackPanel Spacing="{StaticResource Space4}">
                      <!-- xaml-lint: allow card - icon disc -->
                      <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" Margin="{StaticResource GapBottom6}"
                              BorderBrush="{ThemeResource OutlineBrush}">
                        <shapes:Path Data="{x:Bind local:Paint.Icon(IconData)}" Stroke="{ThemeResource OnSurfaceBrush}"
                                   StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" />
                      <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource TypeDisplay15}"
                                 Foreground="{x:Bind local:Paint.Tone(Tone)}" />
                      <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource MicroText}" />
                    </StackPanel>
                  </utu:CardContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </utu:CardContentControl>

        <!-- Operations and composition side by side from 600 px, stacked on a phone -->
        <Grid ColumnSpacing="{utu:Responsive Narrowest=0, Narrow={StaticResource Space16}}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space16}, Narrow=0}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{utu:Responsive Narrowest=0, Narrow=*}" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <utu:CardContentControl AutomationProperties.Name="Cargo operations" Style="{StaticResource PanelCard}">
            <StackPanel Spacing="{StaticResource Space10}">
              <Grid>
                <TextBlock Text="Cargo operations" Style="{StaticResource CardTitleText}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.MovesLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                </StackPanel>
              </Grid>
              <!-- xaml-lint: allow card - clips the scene -->
              <Border CornerRadius="{StaticResource RadiusPanel}" Background="{ThemeResource SurfaceBrush}">
                <controls:CargoOpsScene Vessel="{x:Bind ViewModel.Vessel, Mode=OneWay}" />
              </Border>
              <Grid ColumnSpacing="{StaticResource Space14}" Margin="{StaticResource GapTop4}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource Space8}">
                  <Grid>
                    <TextBlock Text="Unloading" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{x:Bind ViewModel.UnloadLive, Mode=OneWay}" Style="{StaticResource TypeMonoMedium13}" Foreground="{ThemeResource SeaGreenInkBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <controls:TickBar AutomationProperties.Name="{x:Bind ViewModel.UnloadLive, Mode=OneWay}" Height="14" LitToken="SeaGreenInvariantBrush" Percent="{x:Bind ViewModel.UnloadPercent, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="{StaticResource Space8}">
                  <Grid>
                    <TextBlock Text="Loading" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{x:Bind ViewModel.LoadLive, Mode=OneWay}" Style="{StaticResource TypeMonoMedium13}" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <controls:TickBar AutomationProperties.Name="{x:Bind ViewModel.LoadLive, Mode=OneWay}" Height="14" LitToken="AccentInvariantBrush" Percent="{x:Bind ViewModel.LoadPercent, Mode=OneWay}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{x:Bind ViewModel.OpsNote, Mode=OneWay}" Style="{StaticResource CaptionText}"
                         TextWrapping="Wrap" Margin="{StaticResource GapTop2}" />
            </StackPanel>
          </utu:CardContentControl>

          <utu:CardContentControl AutomationProperties.Name="Cargo composition" Style="{StaticResource PanelCard}"
                                  Grid.Row="{utu:Responsive Narrowest=1, Narrow=0}" Grid.Column="{utu:Responsive Narrowest=0, Narrow=1}">
            <StackPanel Spacing="{StaticResource Space14}">
              <TextBlock Text="Cargo composition" Style="{StaticResource PanelTitleText}" />
              <controls:CompositionBar Height="14" Slices="{x:Bind ViewModel.CompositionSlices, Mode=OneWay}" />
              <Grid ColumnSpacing="{StaticResource Space12}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Composition, Mode=OneWay}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CompositionSlice">
                      <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                          <Rectangle Width="9" Height="9" RadiusX="{StaticResource RadiusMark}" RadiusY="{StaticResource RadiusMark}" Fill="{x:Bind local:Paint.Tone(Fill)}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Count}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Column="1" Width="104" Height="104">
                  <controls:DonutChart Radius="38" Thickness="14" Slices="{x:Bind ViewModel.CompositionSlices, Mode=OneWay}" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.TeuLabel, Mode=OneWay}" Style="{StaticResource TitleMedium}" HorizontalAlignment="Center" />
                    <TextBlock Text="TEU" Style="{StaticResource MicroText}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Grid>
            </StackPanel>
          </utu:CardContentControl>
        </Grid>
      </StackPanel>

      <!-- ── Voyage ─────────────────────────────────────────────── -->
      <utu:CardContentControl AutomationProperties.Name="Voyage and clearance" Style="{StaticResource PanelCard}" Padding="{utu:Responsive Narrowest={StaticResource Inset16}, Narrow={StaticResource Inset22x20}}"
                              Grid.Row="{utu:Responsive Narrowest=2, Normal=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=2}"
                              Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1}"
                              Margin="{utu:Responsive Narrowest={StaticResource GapTop16}, Wide={StaticResource GapStart16}}">
        <StackPanel Spacing="{StaticResource Space16}">
          <Grid>
            <TextBlock Text="Voyage" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <!-- xaml-lint: allow card - status pill; half-height radius (99 draws an oval on Skia) -->
            <Border Background="{x:Bind local:VesselsView.SecurityGround(ViewModel.IsCleared), Mode=OneWay}" CornerRadius="11" Padding="{StaticResource Inset10x4}"
                    HorizontalAlignment="Right">
              <TextBlock Text="{x:Bind ViewModel.Security, Mode=OneWay}" Style="{StaticResource LabelExtraSmall}" Foreground="{x:Bind local:VesselsView.SecurityInk(ViewModel.IsCleared), Mode=OneWay}" />
            </Border>
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.Voyage, Mode=OneWay}" Style="{StaticResource BodyLargeText}"
                     TextWrapping="Wrap" LineHeight="20" />

          <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="{StaticResource Space14}" RowSpacing="{StaticResource Space14}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="{StaticResource Space4}">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource CaptionText}" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongLargeText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
          <StackPanel Spacing="{StaticResource Space10}">
            <TextBlock Text="Security clearance" Style="{StaticResource BodyStrongLargeText}" />
            <ItemsControl IsTabStop="False" AutomationProperties.Name="Clearance checks" ItemsSource="{x:Bind ViewModel.Checks, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CheckRow">
                  <Grid ColumnSpacing="{StaticResource Space10}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Mark}" Style="{StaticResource TypeStrong13}"
                               Foreground="{x:Bind local:Paint.Tone(Tone)}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource TypeMono12}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button AutomationProperties.Name="Open in Docking" Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.State.OpenDockingCommand}"
                  MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}"
                  Content="Open in Docking →" HorizontalAlignment="Stretch" Margin="{StaticResource GapTop4}" />
        </StackPanel>
      </utu:CardContentControl>
    </Grid>

    <!-- ── Bay detail ───────────────────────────────────────────── -->
    <!-- Four parts in a row from 1280, two by two from 600, one under another on a phone -->
    <utu:CardContentControl AutomationProperties.Name="{x:Bind ViewModel.BayHeading, Mode=OneWay}" Style="{StaticResource PanelCard}" Grid.Row="2" Padding="{utu:Responsive Narrowest={StaticResource Inset16}, Narrow='22,18'}">
      <StackPanel Spacing="{StaticResource Space12}">
        <controls:FlowPanel Spacing="{StaticResource Space14}" RowSpacing="{StaticResource Space2}">
          <TextBlock Text="{x:Bind ViewModel.BayHeading, Mode=OneWay}" Style="{StaticResource TitleLarge}" />
          <TextBlock Text="{x:Bind ViewModel.BayTotal, Mode=OneWay}" Style="{StaticResource BodyText}"
                     Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Bottom" Margin="{StaticResource GapBottom2}" />
          <TextBlock Text="{x:Bind ViewModel.BayRemaining, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                     VerticalAlignment="Bottom" Margin="{StaticResource GapBottom2}" />
        </controls:FlowPanel>

        <Grid ColumnSpacing="{StaticResource Space16}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space16}, Wide=0}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.1*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- xaml-lint: allow card - clips the scene -->
          <Border CornerRadius="{StaticResource RadiusPanel}" Background="{ThemeResource SurfaceBrush}"
                  Grid.ColumnSpan="{utu:Responsive Narrowest=4, Narrow=2, Wide=1}">
            <controls:BayScene Bay="{x:Bind ViewModel.Bay, Mode=OneWay}" />
          </Border>

          <StackPanel Spacing="{StaticResource Space14}" Padding="{StaticResource Inset4x6}"
                      Grid.Row="{utu:Responsive Narrowest=1, Narrow=0}" Grid.Column="{utu:Responsive Narrowest=0, Narrow=2, Wide=1}"
                      Grid.ColumnSpan="{utu:Responsive Narrowest=4, Narrow=2, Wide=1}">
            <TextBlock Text="{x:Bind ViewModel.BayOpsHeading, Mode=OneWay}" Style="{StaticResource BodyStrongLargeText}" />
            <Grid ColumnSpacing="{StaticResource Space16}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="ms-appx:///Assets/Sprites/crane-rtg-1.png" Width="56" Height="70"
                     Stretch="Uniform" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}">
                <TextBlock Text="Unloaded" Style="{StaticResource CaptionText}" Foreground="{ThemeResource SeaGreenInkBrush}" />
                <TextBlock Text="{x:Bind ViewModel.BayUnloaded, Mode=OneWay}" Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource SeaGreenInkBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="{StaticResource Space4}">
                <TextBlock Text="Remaining" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{x:Bind ViewModel.BayLeft, Mode=OneWay}" Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource PrimaryBrush}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="{StaticResource Space2}">
              <TextBlock Text="Next move" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{x:Bind ViewModel.BayNextMove, Mode=OneWay}" Style="{StaticResource BodyStrongLargeText}" />
              <TextBlock Text="{x:Bind ViewModel.BayNextEta, Mode=OneWay}" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="{StaticResource Space12}" Padding="{StaticResource Inset4x6}"
                      Grid.Row="{utu:Responsive Narrowest=2, Narrow=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=2}"
                      Grid.ColumnSpan="{utu:Responsive Narrowest=4, Narrow=2, Wide=1}">
            <TextBlock Text="{x:Bind ViewModel.BayCompositionHeading, Mode=OneWay}" Style="{StaticResource BodyStrongLargeText}" />
            <Grid ColumnSpacing="{StaticResource Space12}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:DonutChart Width="92" Height="92" VerticalAlignment="Top" Radius="36" Thickness="16" Slices="{x:Bind ViewModel.BaySlices, Mode=OneWay}" />
              <ItemsControl IsTabStop="False" AutomationProperties.Name="{x:Bind ViewModel.BayCompositionHeading, Mode=OneWay}" Grid.Column="1" ItemsSource="{x:Bind ViewModel.BayComposition, Mode=OneWay}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:CompositionSlice">
                    <Grid ColumnSpacing="{StaticResource Space8}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <Rectangle Width="9" Height="9" RadiusX="{StaticResource RadiusMark}" RadiusY="{StaticResource RadiusMark}" Fill="{x:Bind local:Paint.Tone(Fill)}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodySmallText}" />
                      </StackPanel>
                      <TextBlock Text="{x:Bind Count}" Style="{StaticResource CaptionText}"
                                 HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>

          <Grid ColumnSpacing="{StaticResource Space14}" BorderBrush="{ThemeResource OutlineVariantBrush}"
                Grid.Row="{utu:Responsive Narrowest=3, Narrow=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Narrow=2, Wide=3}"
                Grid.ColumnSpan="{utu:Responsive Narrowest=4, Narrow=2, Wide=1}"
                BorderThickness="{utu:Responsive Narrowest='0,1,0,0', Narrow='1,0,0,0'}"
                Padding="{utu:Responsive Narrowest='4,16,4,6', Narrow='18,6,4,6'}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{x:Bind local:Paint.Sprite(ViewModel.BayContainerImage), Mode=OneWay}" Width="110" Height="80" Stretch="Uniform"
                   VerticalAlignment="Top" Margin="{StaticResource GapTop6}" />
            <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}">
              <TextBlock Text="{x:Bind ViewModel.BayContainerId, Mode=OneWay}" Style="{StaticResource TypeMonoMedium14}" />
              <TextBlock Text="{x:Bind ViewModel.BayContainerType, Mode=OneWay}" Style="{StaticResource CaptionText}"
                         TextWrapping="Wrap" />
              <Grid ColumnSpacing="{StaticResource Space14}" RowSpacing="{StaticResource Space6}" Margin="{StaticResource GapTop8}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Weight" Style="{StaticResource MicroText}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BayContainerWeight, Mode=OneWay}"
                           Style="{StaticResource BodyStrongSmallText}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource MicroText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BayContainerStatus, Mode=OneWay}"
                           Style="{StaticResource BodyStrongSmallText}" HorizontalAlignment="Right"
                           Foreground="{ThemeResource PrimaryBrush}" />
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </StackPanel>
    </utu:CardContentControl>
  </Grid>
</UserControl>
