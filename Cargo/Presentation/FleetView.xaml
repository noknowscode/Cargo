<Page x:Class="Cargo.Presentation.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             xmlns:utu="using:Uno.Toolkit.UI">

  <Grid Style="{StaticResource PageFrame}" Padding="{utu:Responsive Narrowest={StaticResource PagePaddingPhone}, Narrow={StaticResource PagePaddingTablet}, Normal={StaticResource PagePadding}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Masthead ─────────────────────────────────────────────── -->
    <!-- The figures sit beside the title from 1280 and wrap under it below -->
    <Grid Style="{StaticResource Masthead}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space12}, Wide=0}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel VerticalAlignment="Bottom" Spacing="{StaticResource Space8}">
        <TextBlock Text="Fleet &amp; waterways" Style="{StaticResource PageTitleText}" />
        <Grid ColumnSpacing="{StaticResource Space8}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Ellipse Width="6" Height="6" Fill="{ThemeResource AlertBrush}" VerticalAlignment="Top" Margin="{StaticResource GapTop6}" />
          <TextBlock Grid.Column="1" Text="Live AIS · Port of Westhaven to the Alder River · 120 km" Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>

      <controls:FlowPanel Spacing="{StaticResource Space28}" RowSpacing="{StaticResource Space4}" VerticalAlignment="Bottom"
                          Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <TextBlock Text="{x:Bind ViewModel.UnderwayCount, Mode=OneWay}" Style="{StaticResource MetricText}" />
          <TextBlock Text="underway" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <TextBlock Text="{x:Bind ViewModel.LateCount, Mode=OneWay}" Style="{StaticResource MetricText}" Foreground="{ThemeResource OrangeInkBrush}" />
          <TextBlock Text="running late" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <TextBlock Text="{x:Bind ViewModel.LockCount, Mode=OneWay}" Style="{StaticResource MetricText}" />
          <TextBlock Text="lockings booked" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <TextBlock Text="{x:Bind ViewModel.NoticeTotal, Mode=OneWay}" Style="{StaticResource MetricText}" Foreground="{ThemeResource AlertInkBrush}" />
          <TextBlock Text="notices" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
      </controls:FlowPanel>
    </Grid>

    <!-- ── Row 1: the river + underway (beside it from 1000 px, under it below) ── -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource RuledPanel}">
        <StackPanel Spacing="{StaticResource Space12}">
          <Grid ColumnSpacing="{StaticResource Space18}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Alder River" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Legend, Mode=OneWay}" VerticalAlignment="Center" IsTabStop="False"
                          Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                          Margin="{utu:Responsive Narrowest={StaticResource GapTop8}, Normal='0'}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:FlowPanel Spacing="{StaticResource Space14}" RowSpacing="{StaticResource Space4}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LegendItem">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                    <Ellipse Width="7" Height="7" Fill="{x:Bind Swatch}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <!-- xaml-lint: allow card - the river chart's ground, not a card -->
          <Border CornerRadius="{StaticResource RadiusPanel}" Background="{ThemeResource LandBrush}">
            <ContentControl x:Name="RiverHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource RuledPanel}"
              Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
              Width="{utu:Responsive Narrowest=NaN, Normal=300}"
              Margin="{utu:Responsive Narrowest='0,28,0,0', Normal='40,0,0,0'}">
        <StackPanel Spacing="{StaticResource Space14}">
          <Grid>
            <TextBlock Text="Underway" Style="{StaticResource PanelTitleText}" />
            <TextBlock Text="{x:Bind ViewModel.FleetCount, Mode=OneWay}" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Fleet, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space2}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FleetRow">
                <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}"
                        AutomationProperties.Name="{x:Bind Name}">
                  <!-- xaml-lint: allow card - the selected-row highlight, not a card -->
                  <Border Background="{x:Bind Background}" CornerRadius="{StaticResource RadiusControl}" Padding="{StaticResource Inset10x8}">
                    <Grid ColumnSpacing="{StaticResource Space10}" RowSpacing="{StaticResource Space4}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <Ellipse Width="6" Height="6" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{x:Bind Slip}" Style="{StaticResource TypeMonoMedium12}" Foreground="{x:Bind SlipInk}" />
                      <TextBlock Grid.Row="1" Text="{x:Bind Detail}" Style="{StaticResource CaptionText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Eta}" Style="{StaticResource CaptionText}"
                                 FontFamily="{StaticResource MonoFont}" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ── Row 2: lockings, gauges, notices, crew: four across from 1280, two by two from 600 (920 px wide), one
         column below -->
    <controls:TileGridPanel Grid.Row="2" Gap="{utu:Responsive Narrowest=28, Normal=40}"
                            MinTileWidth="{utu:Responsive Narrowest=280, Narrow=400, Wide=260}">

      <Border Style="{StaticResource RuledPanel}">
        <StackPanel Spacing="{StaticResource Space14}">
          <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Text="Lockings today" Style="{StaticResource CardTitleText}" />
            <TextBlock Text="{x:Bind ViewModel.BookedLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Lockings, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space10}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LockingRow">
                <Grid ColumnSpacing="{StaticResource Space10}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Time}" Style="{StaticResource TypeMonoMedium12}"
                             Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind Lock}" FontFamily="{StaticResource BodyStrongFont}" /><Run Text=" · " /><Run Text="{x:Bind Vessel}" />
                  </TextBlock>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space6}">
                    <Ellipse Width="6" Height="6" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind State}" Style="{StaticResource StatusText}" Foreground="{x:Bind Ink}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource RuledPanel}">
        <StackPanel Spacing="{StaticResource Space14}">
          <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Text="Water levels" Style="{StaticResource CardTitleText}" />
            <TextBlock Text="Gauges · last 24 h" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Gauges, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space12}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:GaugeRow">
                <Grid ColumnSpacing="{StaticResource Space10}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="64" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{x:Bind Chainage}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                  <!-- Water level: the river's colour over a fade to the baseline -->
                  <Grid Grid.Column="1" Width="80" Height="22" VerticalAlignment="Center">
                    <shapes:Path Data="{x:Bind SparkArea}" Fill="{ThemeResource WaterFadeBrush}" />
                    <shapes:Path Data="{x:Bind Spark}" Stroke="{ThemeResource WaterLineBrush}" StrokeThickness="1.6"
                                 StrokeLineJoin="Round" />
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{x:Bind Level}" Style="{StaticResource TypeMonoMedium12}" Foreground="{x:Bind Ink}" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource RuledPanel}">
        <StackPanel Spacing="{StaticResource Space14}">
          <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Text="Notices to skippers" Style="{StaticResource CardTitleText}" />
            <TextBlock Text="{x:Bind ViewModel.NoticeCount, Mode=OneWay}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space12}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:NoticeRow">
                <Grid ColumnSpacing="{StaticResource Space10}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="6" Height="6" Fill="{x:Bind Tone}" VerticalAlignment="Top" Margin="{StaticResource GapTop6}" />
                  <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Crew channel for the vessel selected under Underway -->
      <Border Style="{StaticResource RuledPanel}">
        <StackPanel Spacing="{StaticResource Space12}">
          <Grid ColumnSpacing="{StaticResource Space10}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource Space4}">
              <TextBlock Text="{x:Bind ViewModel.CrewHeading, Mode=OneWay}" Style="{StaticResource CardTitleText}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.CrewSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space6}" VerticalAlignment="Top" Margin="{StaticResource GapTop4}">
              <Ellipse Width="6" Height="6" Fill="{x:Bind ViewModel.SlipTone, Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind ViewModel.SlipLabel, Mode=OneWay}" Style="{StaticResource StatusText}"
                         Foreground="{x:Bind ViewModel.SlipInk, Mode=OneWay}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{x:Bind ViewModel.ThreadEmptyText, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Visibility="{x:Bind ViewModel.ThreadEmpty, Mode=OneWay}" />
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Thread, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ChatBubble">
                  <StackPanel HorizontalAlignment="{x:Bind Align}" Spacing="{StaticResource Space4}">
                    <!-- xaml-lint: allow card - a chat bubble, not a card -->
                    <Border Background="{x:Bind Background}" CornerRadius="{StaticResource RadiusPanel}" Padding="11,8" MaxWidth="240">
                      <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyText}" Foreground="{x:Bind Foreground}"
                                 TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource TypeMono11}"
                               Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="{x:Bind Align}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ItemsControl ItemsSource="{x:Bind ViewModel.QuickMessages, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space6}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:QuickMessage">
                <Button Style="{StaticResource GhostButton}" Command="{x:Bind Send}" CommandParameter="{x:Bind Text}"
                        Content="{x:Bind Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        MinHeight="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource TouchTarget}, Normal=0}"
                        Padding="{StaticResource Inset12x8}" CornerRadius="{StaticResource RadiusControl}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnSpacing="{StaticResource Space8}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Enter sends: CommandExtensions runs the command on Enter for a TextBox -->
            <TextBox PlaceholderText="Message the crew…" CornerRadius="{StaticResource RadiusControl}"
                     Padding="12,9" AutomationProperties.Name="Message the crew" MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}"
                     Text="{x:Bind ViewModel.State.ChatDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     utu:CommandExtensions.Command="{x:Bind ViewModel.SendDraftCommand, Mode=OneWay}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Send" Command="{x:Bind ViewModel.SendDraftCommand, Mode=OneWay}"
                    CornerRadius="{StaticResource RadiusControl}" MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=0}" />
          </Grid>
        </StackPanel>
      </Border>
    </controls:TileGridPanel>

    <!-- ── Sea & weather and the night's tide ─────────────────────── -->
    <local:SeaWeatherPanel Grid.Row="3" DataContext="{x:Bind ViewModel.State}" />
  </Grid>
</Page>
