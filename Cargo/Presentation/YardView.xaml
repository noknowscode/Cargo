<UserControl x:Class="Cargo.Presentation.YardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!-- The yard map with the selected stack beside it from 1000 px, under it below; the legend beside the title from
       1280, under it below -->
  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="{StaticResource Space24}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="{StaticResource Space4}">
        <TextBlock Text="Yard" Style="{StaticResource SectionHeadText}" />
        <controls:FlowPanel AutomationProperties.Name="{x:Bind ViewModel.LiveLine, Mode=OneWay}" Spacing="{StaticResource Space8}" RowSpacing="{StaticResource Space4}">
          <Ellipse Width="6" Height="6" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind ViewModel.LiveLine, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <controls:TickBar Height="10" VerticalAlignment="Center" Count="20" TickWidth="3" Gap="1.5"
                            TallHeight="10" LitHeight="7" OffHeight="4.5"
                            Percent="{x:Bind ViewModel.Occupancy, Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.OccupancyLine, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </controls:FlowPanel>
        <TextBlock Text="Darker tops are taller stacks. Select a stack to see its tiers." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
      </StackPanel>
      <ItemsControl AutomationProperties.Name="Yard legend" ItemsSource="{x:Bind ViewModel.Legend, Mode=OneWay}" VerticalAlignment="Bottom" IsTabStop="False"
                    Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                    Margin="{utu:Responsive Narrowest={StaticResource GapTop10}, Wide='0'}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><controls:FlowPanel Spacing="{StaticResource Space14}" RowSpacing="{StaticResource Space6}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:LegendItem">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
              <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource RadiusMark}" RadiusY="{StaticResource RadiusMark}" Fill="{x:Bind local:Paint.Swatch(Swatch, Strength)}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <utu:CardContentControl AutomationProperties.Name="Yard map" Style="{StaticResource OutlinedPanel}" Padding="0" VerticalAlignment="Top"
                              CornerRadius="{StaticResource RadiusCard}" Background="{ThemeResource LandBrush}">
        <ContentControl x:Name="MapHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
      </utu:CardContentControl>

      <utu:CardContentControl AutomationProperties.Name="{x:Bind ViewModel.SlotTitle, Mode=OneWay}" Style="{StaticResource PanelCard}" Padding="{StaticResource Inset22x20}" VerticalAlignment="Top"
                              Visibility="{x:Bind ViewModel.HasStack, Mode=OneWay}"
                              Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                              Width="{utu:Responsive Narrowest=NaN, Normal=300}"
                              Margin="{utu:Responsive Narrowest={StaticResource GapTop18}, Normal={StaticResource GapStart18}}">
        <StackPanel Spacing="{StaticResource Space14}">
          <Grid>
            <StackPanel Spacing="{StaticResource Space4}">
              <TextBlock Text="{x:Bind ViewModel.SlotTitle, Mode=OneWay}" Style="{StaticResource TypeStrong18}" />
              <TextBlock Text="{x:Bind ViewModel.SlotSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Style="{StaticResource CloseButton}" Content="×" Command="{x:Bind ViewModel.CloseStackCommand, Mode=OneWay}"
                    MinWidth="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=32}"
                    MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=32}"
                    AutomationProperties.Name="Close stack" ToolTipService.ToolTip="Close stack" />
          </Grid>

          <controls:StackTiers Boxes="{x:Bind ViewModel.StackBoxes, Mode=OneWay}" />

          <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
          <ItemsControl IsTabStop="False" AutomationProperties.Name="Stack tiers" ItemsSource="{x:Bind ViewModel.Tiers, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:TierRow">
                <Grid>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <Rectangle Width="9" Height="9" RadiusX="{StaticResource RadiusMark}" RadiusY="{StaticResource RadiusMark}" Fill="{x:Bind local:Paint.Tone(Tone)}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Id}" Style="{StaticResource TypeMonoMedium12}" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </utu:CardContentControl>
    </Grid>
  </Grid>
</UserControl>
