<UserControl x:Class="Cargo.Presentation.OverviewMasthead"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:Cargo.Controls">

  <!-- Desktop (1280+) keeps greeting, figures and card on one line; below it the figures take a full-width line under
       the greeting and the card; phones (under 600) drop the card, whose operator and shift are in the account flyout -->
  <!-- The Overview greeting, the shift's headline figures and the duty operator's ID card.
       Figures are ink; colour only marks status, as the mark before each label. -->
  <Grid ColumnSpacing="{utu:Responsive Narrowest=0, Narrow={StaticResource Space500}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space100}">
      <TextBlock Style="{StaticResource GreetingText}" TextWrapping="Wrap">
        <Run Text="Good evening, " /><Run Text="{x:Bind ViewModel.GreetingName}" Foreground="{ThemeResource PrimaryBrush}" />
      </TextBlock>
      <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource DateLineText}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space300}" VerticalAlignment="Center" Padding="{StaticResource Space050TopThickness}"
                Grid.Row="{utu:Responsive Narrowest=1, Wide=0}"
                Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1}"
                Margin="{utu:Responsive Narrowest={StaticResource Space200TopThickness}, Wide='0'}">
      <StackPanel Style="{StaticResource FigureStack}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Ellipse Width="8" Height="8" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Alongside" Style="{StaticResource FigureLabelText}" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Alongside, Mode=OneWay}" Style="{StaticResource MetricText}" />
      </StackPanel>

      <StackPanel Style="{StaticResource FigureStack}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Ellipse Width="8" Height="8" Stroke="{ThemeResource NavyBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
          <TextBlock Text="Inbound" Style="{StaticResource FigureLabelText}" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Inbound, Mode=OneWay}" Style="{StaticResource MetricText}" />
      </StackPanel>

      <Rectangle Width="1" Fill="{ThemeResource OutlineBrush}" />

      <!-- A link to the queue: scrolls it into view and focuses its heading -->
      <Button Style="{StaticResource BareButton}" Command="{x:Bind ViewModel.State.Navigation.RevealNeedsYouCommand}"
              AutomationProperties.Name="{x:Bind ViewModel.NeedsYouLink, Mode=OneWay}">
        <StackPanel Style="{StaticResource FigureStack}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
            <Rectangle Width="8" Height="8" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Needs you" Style="{StaticResource FigureLabelText}" />
          </StackPanel>
          <TextBlock Text="{x:Bind ViewModel.NeedsYouText, Mode=OneWay}" Style="{StaticResource MetricText}"
                     Foreground="{ThemeResource ErrorBrush}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Duty operator: an ID card clipped to the masthead.
         Shadows inline: a Style-supplied collection never applies (Toolkit gotcha G36). -->
    <utu:ShadowContainer Grid.Column="2" Grid.RowSpan="{utu:Responsive Narrowest=1, Wide=2}" Width="252" VerticalAlignment="Center"
                         Background="{ThemeResource SurfaceBrush}"
                         controls:IdCardMotion.IsEnabled="True"
                         Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}"
                         AutomationProperties.Name="{x:Bind ViewModel.OperatorSummary}">
      <utu:ShadowContainer.RenderTransform>
        <TranslateTransform />
      </utu:ShadowContainer.RenderTransform>
      <utu:ShadowContainer.Shadows>
        <utu:ShadowCollection>
          <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
          <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
          <utu:Shadow OffsetY="12" BlurRadius="28" Color="{ThemeResource ShadowColor}" Opacity="0.08" />
        </utu:ShadowCollection>
      </utu:ShadowContainer.Shadows>

      <Grid CornerRadius="{StaticResource Radius300CornerRadius}" Padding="16,15,16,12" RowSpacing="{StaticResource Space125}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- xaml-lint: allow card - the ID card's clip slot, a 28x4 punched mark -->
        <Border Width="28" Height="4" CornerRadius="{StaticResource Radius050CornerRadius}" Margin="0,-8,0,0" VerticalAlignment="Top"
                Background="{ThemeResource BackgroundBrush}"
                BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1" />

        <!-- The sub-line spans under the badge: in the badge's column alone it would clip at 252 px -->
        <Grid ColumnSpacing="{StaticResource Space150}" RowSpacing="{StaticResource Space050}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.RowSpan="2" Width="36" Height="36" VerticalAlignment="Center">
            <Ellipse Fill="{ThemeResource PrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Operator.Initials}" Style="{StaticResource CardInitialsText}" />
          </Grid>
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Operator.Name}" Style="{StaticResource CardNameText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Operator.Badge}" Style="{StaticResource BadgeMonoText}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.OperatorSince}"
                     Style="{StaticResource CaptionText}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource Space125}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar controls:Slide.Value="{x:Bind ViewModel.ShiftProgress, Mode=OneWay}" Maximum="1" VerticalAlignment="Center"
                       Height="3" MinHeight="3" CornerRadius="{StaticResource Radius050CornerRadius}"
                       Foreground="{ThemeResource PrimaryBrush}" Background="{ThemeResource OutlineVariantBrush}"
                       AutomationProperties.Name="Shift progress" />
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OperatorUntil}" Style="{StaticResource TypeMono11}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        </Grid>
      </Grid>
    </utu:ShadowContainer>
  </Grid>
</UserControl>
