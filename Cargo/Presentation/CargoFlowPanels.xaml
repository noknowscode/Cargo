<UserControl x:Class="Cargo.Presentation.CargoFlowPanels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!-- The terminal's throughput: moves this hour by the block, and cargo entering against leaving.
       Moved from Overview, whose timeline now carries moves and cargo on the day's axis. -->
  <!-- Side by side from 1000 px, stacked below -->
  <Grid ColumnSpacing="{utu:Responsive Narrowest=0, Normal={StaticResource Space40}}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space28}, Normal=0}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{utu:Responsive Narrowest=0, Normal=*}" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource RuledPanel}" Padding="{StaticResource RuledPanelInsetEnd}">
      <StackPanel>
        <TextBlock Text="Container volume" Style="{StaticResource CardTitleText}" />
        <TextBlock Text="Moves this hour · one block = 20" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Margin="{StaticResource GapTop4}">
          <TextBlock Text="{x:Bind local:CargoFlowPanels.Moves(ViewModel.NowHours), Mode=OneWay}" Style="{StaticResource MetricText}" />
          <TextBlock Text="↑ 12% vs yesterday" Style="{StaticResource BodyStrongSmallText}"
                     Foreground="{ThemeResource SeaGreenInkBrush}" VerticalAlignment="Bottom" Margin="{StaticResource GapBottom4}" />
        </StackPanel>
        <controls:VolumeChart AutomationProperties.Name="Container moves per hour" Now="{x:Bind ViewModel.NowHours, Mode=OneWay}" Margin="{StaticResource GapTop8}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource RuledPanel}" Padding="{StaticResource RuledPanelInsetEnd}"
            Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}">
      <StackPanel>
        <Grid>
          <TextBlock Text="Cargo flow" Style="{StaticResource CardTitleText}" />
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
              <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Entering" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
              <Ellipse Width="6" Height="6" Fill="{ThemeResource AmberBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Leaving" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <controls:FlowChart AutomationProperties.Name="Cargo entering against leaving" Margin="{StaticResource GapTop14}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
