<UserControl x:Class="Cargo.Presentation.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             xmlns:media="using:Microsoft.UI.Xaml.Media"
             xmlns:controls="using:Cargo.Controls"
             xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:not_win="http://uno.ui/not_win"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="not_win">

  <UserControl.Resources>
    <!-- Below 1040 the two columns stack (the Overview's narrow band) -->

    <!-- One log entry: time, icon, what happened; an entry about an open decision carries NEEDS ACTION.
         Clicking it opens its detail: the row rises 2 px onto a surface, the detail grows in below,
         and the other rows in its column blur back (Reveal, 240 ms on EaseSmooth). -->
    <DataTemplate x:Key="FeedRowTemplate" x:DataType="local:FeedEntry">
      <Grid BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,1,0,0">
        <Grid controls:Reveal.IsOn="{x:Bind IsExpanded, Mode=OneWay}" controls:Reveal.Rise="2" controls:Reveal.Fade="False">
          <Grid.RenderTransform>
            <TranslateTransform />
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- The lift: a surface on a soft float shadow, bleeding 12 px past the text. Shadows inline (Toolkit gotcha G36) -->
          <utu:ShadowContainer Grid.RowSpan="2" Margin="-12,4,-12,2" Background="{ThemeResource SurfaceBrush}"
                               Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                               controls:Reveal.IsOn="{x:Bind IsExpanded, Mode=OneWay}" controls:Reveal.Hides="True">
            <utu:ShadowContainer.Shadows>
              <utu:ShadowCollection>
                <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.06" />
                <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.05" />
                <utu:Shadow OffsetY="10" BlurRadius="28" Color="{ThemeResource ShadowColor}" Opacity="0.09" />
              </utu:ShadowCollection>
            </utu:ShadowContainer.Shadows>
            <Border CornerRadius="{StaticResource Radius200CornerRadius}" />
          </utu:ShadowContainer>

          <Button Style="{StaticResource BareButton}" Command="{x:Bind Toggle}" CommandParameter="{x:Bind}" Padding="{StaticResource Space150VerticalThickness}"
                  AutomationProperties.Name="{x:Bind Title}">
            <Grid ColumnSpacing="{StaticResource Space150}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind Time}" Style="{StaticResource TypeMono13}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <Viewbox Grid.Column="1" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.AccessibilityView="Raw">
                <Grid Width="24" Height="24">
                  <shapes:Path Data="{x:Bind local:ActivityView.Icon(IconData, About)}" Stroke="{x:Bind local:ActivityView.Tone(NeedsAction)}" Style="{StaticResource StrokeIcon}" />
                </Grid>
              </Viewbox>
              <StackPanel Grid.Column="2" Spacing="{StaticResource Space025}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource TypeMedium15}" Foreground="{ThemeResource OnSurfaceBrush}" />
                  <!-- xaml-lint: allow card - the NEEDS ACTION chip, a caps label on an alert tint -->
                  <Border Background="{ThemeResource ErrorContainerBrush}" CornerRadius="{StaticResource Radius100CornerRadius}" Padding="6,3" VerticalAlignment="Center"
                          Visibility="{x:Bind NeedsAction}">
                    <TextBlock Text="NEEDS ACTION" Style="{StaticResource TypeStrong11}" Foreground="{ThemeResource OnSurfaceBrush}" />
                  </Border>
                </StackPanel>
                <!-- Open, the line wraps in full -->
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis"
                           TextWrapping="{x:Bind local:ActivityView.Wrap(IsExpanded), Mode=OneWay}" />
              </StackPanel>
            </Grid>
          </Button>

          <!-- The detail: when it was logged and, for an entry about an open decision, that decision and its action -->
          <StackPanel Grid.Row="1" Margin="92,0,0,14" Spacing="{StaticResource Space125}" Opacity="0" Visibility="Collapsed"
                      controls:Reveal.IsOn="{x:Bind IsExpanded, Mode=OneWay}" controls:Reveal.Grow="True">
            <TextBlock Text="{x:Bind Logged, Mode=OneWay}" Style="{StaticResource TypeMono12}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            <Grid ColumnSpacing="{StaticResource Space150}" Visibility="{x:Bind NeedsAction}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="{StaticResource Space025}" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind About.Title}" Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource SubtitleText}" TextWrapping="Wrap">
                  <Run Text="{x:Bind About.Sub}" /><Run Text="{x:Bind local:NeedsYouPanel.Separator(About.When), Mode=OneWay}" /><Run Text="{x:Bind About.When, Mode=OneWay}"
                       Foreground="{x:Bind local:NeedsYouPanel.WhenInk(About.IsLate), Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
              <Button AutomationProperties.Name="{x:Bind About.ActionLabel}" Grid.Column="1" Content="{x:Bind About.ActionLabel}" Style="{x:Bind local:NeedsYouPanel.Action(About.IsPrimary)}"
                      Command="{x:Bind Act}" CommandParameter="{x:Bind About}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Grid>

        <!-- Blur-back: another row in this column is open. Acrylic's blur is fixed and erases 13-15 px text, so it
             stops at 75% and the row reads through as soft focus. A childless Border so the Skia path works on Android too.
             UseCompositionEffectBrush is Uno-only (the Skia blur path; WinUI's XAML compiler rejects it), so the WinAppSDK
             head gets the same brush without it (conditional XAML) -->
        <Border Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                controls:Reveal.IsOn="{x:Bind IsDimmed, Mode=OneWay}" controls:Reveal.Hides="True" controls:Reveal.OnOpacity="0.75">
          <Border.Background>
            <win:AcrylicBrush AlwaysUseFallback="False"
                              TintColor="{ThemeResource SurfaceColor}" TintOpacity="0.1" FallbackColor="{ThemeResource SurfaceColor}" />
            <not_win:AcrylicBrush AlwaysUseFallback="False" media:AcrylicBrushExtensions.UseCompositionEffectBrush="False"
                                  TintColor="{ThemeResource SurfaceColor}" TintOpacity="0.1" FallbackColor="{ThemeResource SurfaceColor}" />
          </Border.Background>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The shift log, newest first, in two columns -->
  <utu:CardContentControl AutomationProperties.Name="Activity" Style="{StaticResource OutlinedPanel}" Padding="24,24,24,12">
    <StackPanel Spacing="{StaticResource Space100}">
      <StackPanel Spacing="{StaticResource Space050}" Margin="{StaticResource Space100BottomThickness}">
        <TextBlock Text="Activity" Style="{StaticResource PanelHeadingText}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Text="{x:Bind ViewModel.Sub, Mode=OneWay}" Style="{StaticResource SubtitleText}" />
      </StackPanel>
      <TextBlock Text="No activity yet today" Style="{StaticResource SubtitleText}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
      <Grid ColumnSpacing="{utu:Responsive Narrowest=0, Normal={StaticResource Space300}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{utu:Responsive Narrowest=0, Normal=*}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl AutomationProperties.Name="Activity, newest" ItemsSource="{x:Bind ViewModel.Left, Mode=OneWay}" ItemTemplate="{StaticResource FeedRowTemplate}" IsTabStop="False" />
        <ItemsControl AutomationProperties.Name="Activity, earlier" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"
                      Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                      ItemsSource="{x:Bind ViewModel.Right, Mode=OneWay}" ItemTemplate="{StaticResource FeedRowTemplate}" IsTabStop="False" />
      </Grid>
    </StackPanel>
  </utu:CardContentControl>
</UserControl>
