<UserControl x:Class="Cargo.Presentation.ScannerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!-- A floating panel over the dimmed page, not a full-window takeover: the section you came from
       stays visible around it. At most 1320 x 820, 48 px from the window edges from 1000 px (24 below).
       Below 1000 the scan result moves under the stage and scrolls on its own (200 px, so the stage keeps the
       height for the box) and the stage's insets tighten; on a phone the panel fills the window, as a sheet would.
       A short window 600 to 999 wide (a phone on its side, 844 x 390) has no height for the stage over the result, so
       the result goes back beside the stage, 300 wide, and the panel takes the window's edges (the Short state). -->
  <!-- Modal to the keyboard: focus moves to Close when it opens, Tab cycles inside it, Escape closes it -->
  <Grid Background="{ThemeResource SimpleBackgroundUtilitiesOverlayBrush}" TabFocusNavigation="Cycle" KeyDown="OnKeyDown"
        SizeChanged="OnSizeChanged">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="HeightStates">
        <VisualState x:Name="Short">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind IsShortLandscape, Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Panel.Margin" Value="0" />
            <Setter Target="Panel.CornerRadius" Value="0" />
            <Setter Target="Stage.(Grid.RowSpan)" Value="2" />
            <Setter Target="Result.(Grid.Row)" Value="0" />
            <Setter Target="Result.(Grid.Column)" Value="1" />
            <Setter Target="Result.(Grid.RowSpan)" Value="2" />
            <Setter Target="Result.Width" Value="300" />
            <Setter Target="Result.MaxHeight" Value="820" />
            <Setter Target="Result.BorderThickness" Value="1,0,0,0" />
            <Setter Target="RotateHint.Visibility" Value="Collapsed" />
            <Setter Target="ScanMeta.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  <!-- Where the panel reaches a phone's status bar, gesture bar or cutout (the window's edges), SafeArea pads its content
       into the visible bounds and the ink runs on behind them; it pads nothing where the panel sits inside them.
       The scanner is a dark stage in both themes: the panel takes the Dark theme, so its role brushes are the Dark
       palette's (code-behind and the 3D box ask Tokens for ElementTheme.Dark) -->
  <Grid x:Name="Panel" RequestedTheme="Dark" Background="{ThemeResource BackgroundBrush}" MaxWidth="1320" MaxHeight="820"
        CornerRadius="{utu:Responsive Narrowest='0', Narrow={StaticResource Radius400CornerRadius}}"
        Margin="{utu:Responsive Narrowest='0', Narrow={StaticResource Space300Thickness}, Normal='48'}"
        utu:SafeArea.Insets="VisibleBounds">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Inspection stage ─────────────────────────────────────── -->
    <Grid x:Name="Stage" Grid.RowSpan="{utu:Responsive Narrowest=1, Normal=2}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.Background>
        <RadialGradientBrush Center="0.5,0.6" RadiusX="0.8" RadiusY="0.9">
          <GradientStop Offset="0" Color="{StaticResource ScanStageInnerColor}" />
          <GradientStop Offset="1" Color="{StaticResource ScanStageOuterColor}" />
        </RadialGradientBrush>
      </Grid.Background>

      <controls:GridPaper Grid.RowSpan="3" Opacity="0.5" />
      <controls:ContainerScanner x:Name="Scanner3D" Grid.Row="1" />

      <Grid Padding="{utu:Responsive Narrowest={StaticResource Space200Thickness}, Normal='28,24'}" ColumnSpacing="{StaticResource Space250}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="{StaticResource Space100}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <Ellipse Width="7" Height="7" Fill="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.ScanMode, Mode=OneWay}" Style="{StaticResource TypeMonoMedium11}"
                       Foreground="{ThemeResource PrimaryBrush}" />
          </StackPanel>
          <TextBlock Text="{x:Bind ViewModel.ContainerId, Mode=OneWay}" Style="{StaticResource TypeMonoMedium24}"
                     Foreground="{ThemeResource OnSurfaceBrush}" />
          <TextBlock x:Name="ScanMeta" Text="{x:Bind ViewModel.ContainerMeta, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CloseOnDarkButton}" Content="×" Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                Width="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=34}" Height="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=34}"
                CornerRadius="{StaticResource RadiusFullCornerRadius}"
                AutomationProperties.Name="Close scanner" ToolTipService.ToolTip="Close scanner" />
      </Grid>

      <!-- The view presets, X-ray and zoom: the keyboard's way to turn and size the box the pointer drags. They wrap
           onto a second line when the stage is narrow -->
      <Grid Grid.Row="2" Padding="{utu:Responsive Narrowest='16,0,16,16', Normal='28,0,20,24'}" ColumnSpacing="{StaticResource Space250}" RowSpacing="{StaticResource Space100}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:FlowPanel Spacing="{StaticResource Space075}" RowSpacing="{StaticResource Space100}" VerticalAlignment="Center">
          <ItemsControl AutomationProperties.Name="View presets" ItemsSource="{x:Bind ViewModel.Views, Mode=OneWay}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ScanViewOption">
                <Button Style="{StaticResource BareButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Label}"
                        AutomationProperties.Name="{x:Bind AccessibleName}">
                  <!-- xaml-lint: allow card - a view-preset toggle; the Simple theme ships no segmented style -->
                  <Border Background="{x:Bind local:ScannerOverlay.PresetGround(IsCurrent)}" BorderBrush="{ThemeResource OutlineVariantBrush}"
                          BorderThickness="1" CornerRadius="{StaticResource Radius200CornerRadius}" Padding="{StaticResource Inset12x7}"
                          MinHeight="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}">
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource TypeMedium12}" VerticalAlignment="Center"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Rectangle Width="1" Height="20" Fill="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource Space075HorizontalThickness}" VerticalAlignment="Center"
                     Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}" />

          <Button Style="{StaticResource BareButton}" Command="{x:Bind ViewModel.ToggleXrayCommand, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.XrayName, Mode=OneWay}">
            <!-- xaml-lint: allow card - the X-ray toggle face -->
            <Border Background="{x:Bind local:ScannerOverlay.XrayGround(ViewModel.IsXray), Mode=OneWay}" BorderBrush="{x:Bind local:ScannerOverlay.XrayEdge(ViewModel.IsXray), Mode=OneWay}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius200CornerRadius}" Padding="{StaticResource Inset14x7}" MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" VerticalAlignment="Center">
                <shapes:Path Data="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4"
                             Stroke="{x:Bind local:ScannerOverlay.XrayInk(ViewModel.IsXray), Mode=OneWay}" StrokeThickness="2"
                             Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="X-ray" Style="{StaticResource TypeMedium12}"
                           Foreground="{x:Bind local:ScannerOverlay.XrayInk(ViewModel.IsXray), Mode=OneWay}" />
              </StackPanel>
            </Border>
          </Button>

          <!-- Phones leave the hint out (a touch drag is the expected gesture) to keep the stage tall enough for the box -->
          <TextBlock x:Name="RotateHint" Text="Drag to rotate" Style="{StaticResource CaptionText}" Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="{StaticResource Space125LeftThickness}" />
        </controls:FlowPanel>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}" VerticalAlignment="Center"
                    Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}">
          <Button Style="{StaticResource GhostButton}" Content="−" Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneWay}" AutomationProperties.Name="Zoom out"
                  Width="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}" Height="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}"
                  CornerRadius="{StaticResource Radius200CornerRadius}" Padding="0" />
          <Button Style="{StaticResource GhostButton}" Content="+" Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneWay}" AutomationProperties.Name="Zoom in"
                  Width="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}" Height="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}"
                  CornerRadius="{StaticResource Radius200CornerRadius}" Padding="0" />
          <Button AutomationProperties.Name="Reset view" Style="{StaticResource GhostButton}" Content="Reset view" Command="{x:Bind ViewModel.ResetViewCommand, Mode=OneWay}"
                  Height="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}"
                  CornerRadius="{StaticResource Radius200CornerRadius}" Padding="{StaticResource Space150HorizontalThickness}" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ── Scan result ──────────────────────────────────────────── -->
    <ScrollViewer AutomationProperties.Name="Scan result" x:Name="Result" Background="{ThemeResource BackgroundBrush}" VerticalScrollBarVisibility="Auto"
                  Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                  Grid.RowSpan="{utu:Responsive Narrowest=1, Normal=2}"
                  Width="{utu:Responsive Narrowest=NaN, Normal=360}" MaxHeight="{utu:Responsive Narrowest=200, Normal=820}"
                  BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="{utu:Responsive Narrowest='0,1,0,0', Normal='0'}">
      <!-- The inset is on the content, not the ScrollViewer: with a set width Uno let the content run under a
           ScrollViewer's right padding -->
      <StackPanel Spacing="{StaticResource Space200}" Padding="{utu:Responsive Narrowest='16,18', Normal='24,26'}">
        <StackPanel Spacing="{StaticResource Space100}">
          <TextBlock Text="SCAN RESULT" Style="{StaticResource TypeMonoMedium11}"
                     Foreground="{ThemeResource PrimaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}">
            <Ellipse Width="10" Height="10" Fill="{x:Bind local:ScannerOverlay.Tone(ViewModel.VerdictTone), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.Verdict, Mode=OneWay}" Style="{StaticResource TypeStrong18}"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
          </StackPanel>
          <TextBlock Text="{x:Bind ViewModel.VerdictNote, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" LineHeight="19" />
        </StackPanel>

        <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
        <StackPanel Spacing="{StaticResource Space150}">
          <TextBlock Text="DENSITY MAP" Style="{StaticResource TypeMonoMedium11}"
                     Foreground="{ThemeResource PrimaryBrush}" />
          <controls:CompositionBar AutomationProperties.Name="Density map" BarHeight="10" Slices="{x:Bind ViewModel.DensitySlices, Mode=OneWay}" />
          <ItemsControl IsTabStop="False" AutomationProperties.Name="Density by material" ItemsSource="{x:Bind ViewModel.Density, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space100}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:CompositionSlice">
                <Grid>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <Rectangle Width="9" Height="9" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{x:Bind local:ScannerOverlay.Tone(Fill)}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind Count}" Style="{StaticResource CaptionText}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
        <StackPanel Spacing="{StaticResource Space150}">
          <TextBlock Text="{x:Bind ViewModel.ManifestHeading, Mode=OneWay}" Style="{StaticResource TypeMonoMedium11}" Foreground="{ThemeResource PrimaryBrush}" />
          <ItemsControl IsTabStop="False" AutomationProperties.Name="{x:Bind ViewModel.ManifestHeading, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Manifest, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space125}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ManifestRow">
                <Grid ColumnSpacing="{StaticResource Space125}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{x:Bind local:ScannerOverlay.Tone(Tone)}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyText}"
                             Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Flag}" Style="{StaticResource TypeMonoMedium12}" Foreground="{x:Bind local:ScannerOverlay.FlagInk(Flagged)}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
        <ItemsControl IsTabStop="False" AutomationProperties.Name="Scan facts" ItemsSource="{x:Bind ViewModel.ScanFacts, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:Fact">
              <Grid Padding="0,9" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyText}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBlock Text="{x:Bind Value}" Style="{StaticResource TypeMonoMedium13}"
                           Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:FlowPanel Spacing="{StaticResource Space100}" RowSpacing="{StaticResource Space100}">
          <Button AutomationProperties.Name="Close scanner" Style="{StaticResource GhostButton}" Content="Close" Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Width="150" MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}" />
          <Button AutomationProperties.Name="{x:Bind ViewModel.ScanAction, Mode=OneWay}" Style="{StaticResource AccentButton}" Content="{x:Bind ViewModel.ScanAction, Mode=OneWay}" Width="150" MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}"
                  Command="{x:Bind ViewModel.TakeScanActionCommand, Mode=OneWay}" />
        </controls:FlowPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Grid>
</UserControl>
