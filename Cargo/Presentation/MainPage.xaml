<Page x:Class="Cargo.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cargo.Presentation"
      xmlns:harbour="using:Cargo.Controls.Harbour"
      xmlns:controls="using:Cargo.Controls"
      xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!-- Two layers: the page, and the inspection over the whole window. The overlay stays out of the
       page rows so its size never feeds the Auto stage row. -->
  <Grid>
  <Grid uen:Region.Attached="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
    <!-- On a phone the header's surface runs up behind the status bar (and a cutout on its side) while SafeArea pads its
         content into the visible bounds; desktop and the browser report no insets. The insets go on this wrapper, so the
         header's responsive padding stays its own (SafeArea keeps the padding it found when it attached) -->
    <Border Grid.Row="0" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
            utu:SafeArea.Insets="Left,Top,Right">
    <Grid Padding="{utu:Responsive Narrowest='16,0,10,0', Narrow='24,0,16,0', Normal='40,0,28,0'}"
          ColumnSpacing="{utu:Responsive Narrowest={StaticResource Space12}, Normal={StaticResource Space28}}">
      <!-- Below 1000 the section tabs take a second row of their own, scrolling sideways on a phone -->
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="Westhaven Port Authority" Style="{StaticResource WordmarkText}" VerticalAlignment="Center" />

      <!-- Sections: text tabs; a section with something waiting on you carries an alert dot -->
      <ScrollViewer Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1}" Height="{utu:Responsive Narrowest=44, Normal=NaN}"
                    Margin="{utu:Responsive Narrowest='-12,0,0,0', Normal='0'}"
                    HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
      <ItemsControl IsTabStop="False" AutomationProperties.Name="Sections" x:Name="SectionTabs" ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}" VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:NavItem">
            <!-- Phones: a 44 px row of their own, 13 px labels 10 px apart, so all five fit from 360 (narrower, the row scrolls) -->
            <Button Style="{StaticResource NavTabButton}" uen:Navigation.Request="{x:Bind Route}"
                    Height="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest=44, Normal=56}"
                    Foreground="{x:Bind local:Paint.CurrentInk(IsCurrent), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" VerticalAlignment="Center"
                            Margin="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource InsetX6}, Normal={StaticResource InsetX12}}">
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource TitleSmall}"
                             FontSize="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource LabelMediumFontSize}, Normal={StaticResource LabelLargeFontSize}}"
                             Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource LabelLarge}"
                             FontSize="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource LabelMediumFontSize}, Normal={StaticResource LabelLargeFontSize}}"
                             Visibility="{x:Bind local:Paint.Unless(IsCurrent), Mode=OneWay}" />
                  <Ellipse Width="6" Height="6" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Top"
                           Margin="0,1,0,0" Visibility="{x:Bind NeedsYou, Mode=OneWay}" />
                </StackPanel>
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{ThemeResource PrimaryBrush}"
                           Opacity="{x:Bind local:Paint.Shown(IsCurrent), Mode=OneWay}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
        <!-- Minutes roll; seconds tick plainly. Phones leave the time to the device's status bar -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}"
                    AutomationProperties.Name="{x:Bind ViewModel.State.Now, Mode=OneWay}">
          <controls:RollingText Text="{x:Bind ViewModel.State.NowMinutes, Mode=OneWay}" Style="{StaticResource HeaderClockFigure}" />
          <TextBlock Text="{x:Bind ViewModel.State.NowSeconds, Mode=OneWay}" Style="{StaticResource HeaderClockText}" />
        </StackPanel>

        <!-- Account: who is on shift, and the settings: reduced motion (Skia desktop always reports
             animations enabled, so the app keeps its own) and the theme (System, Light or Dark) -->
        <Button Style="{StaticResource BareButton}" Width="44" Height="44"
                AutomationProperties.Name="{x:Bind ViewModel.AccountName}"
                ToolTipService.ToolTip="{x:Bind ViewModel.AccountName}">
          <Grid>
            <Ellipse Width="32" Height="32" Fill="{ThemeResource PrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Operator.Initials}" Style="{StaticResource AvatarInitialsText}" />
          </Grid>
          <Button.Flyout>
            <!-- A Flyout, not a MenuFlyout: the operator's name and shift are information, and a
                 MenuFlyout can only show them as disabled (unreadable) items -->
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="240" Spacing="{StaticResource Space12}">
                <StackPanel Spacing="{StaticResource Space4}">
                  <TextBlock Text="{x:Bind ViewModel.Operator.Name}" Style="{StaticResource TitleText}" />
                  <TextBlock Text="{x:Bind ViewModel.OperatorLine}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                </StackPanel>
                <Rectangle Height="1" Fill="{ThemeResource OutlineVariantBrush}" />
                <ToggleSwitch AutomationProperties.Name="Reduce motion" Header="Reduce motion" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}"
                              ToolTipService.ToolTip="Hold the cranes, trucks and camera moves still" />
                <!-- Order matches MainViewModel.ThemeIndex: System follows the device -->
                <RadioButtons Header="Theme" MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                              AutomationProperties.Name="Theme">
                  <x:String>System</x:String>
                  <x:String>Light</x:String>
                  <x:String>Dark</x:String>
                </RadioButtons>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>
    </Border>

    <!-- ══ SHARED HARBOUR STAGE ════════════════════════════════════════ -->
    <Grid x:Name="StageHost" Grid.Row="1" Visibility="{x:Bind ViewModel.State.Stage.Shown, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- Overview: the greeting, figures and duty card on the page ground, above the harbour band -->
      <!-- Overlays the harbour, which reaches up behind it (HarbourView.OverlayHeight); folds away when Overview
           scrolls (SPEC-OVERVIEW-SCROLL), in step with the band's snap to its mini. Drawn above the harbour
           (ZIndex). The padding lives on this wrapper so the fold takes it too -->
      <Border x:Name="MastheadFrame" Canvas.ZIndex="1" Padding="{utu:Responsive Narrowest={StaticResource Inset16x12}, Narrow='24,14,24,14', Normal='40,14,40,14'}" Visibility="Collapsed" Opacity="0"
              controls:Reveal.IsOn="{x:Bind ViewModel.State.Stage.MastheadShown, Mode=OneWay}" controls:Reveal.Grow="True"
              controls:Reveal.DurationKey="DurationExpandMs">
        <!-- From 1600 the greeting lines up with Overview's centred column (1440 less its 40 px sides) -->
        <local:OverviewMasthead x:Name="Masthead" MaxWidth="1360" DataContext="{x:Bind ViewModel.Overview, Mode=OneWay}" />
      </Border>
      <!-- One harbour for every harbour page: Overview's 340 px band (491 expanded), a strip framed by
           the section elsewhere -->
      <harbour:HarbourView AutomationProperties.Name="Harbour" x:Name="Harbour" Grid.Row="1" />
      <!-- Layer switcher: centred on the HUD row from 1280; below it the centred switcher (370 px) would run into the
           Key and scale/zoom group, so it stacks above the camera menu (16 + 44 + 4 px up). 44 px tall below 1000 -->
      <!-- WORKAROUND(ShadowContainer keeps its paint when only its offset changes): the responsive
           alignment and margin live on this wrapper, so the ShadowContainer never moves within its parent.
           Still needed on Uno.Sdk 7.0.0-dev.115 / Toolkit 11.0.0-dev.157 (repro: docs/evidence/2026-10-01-shadowcontainer-offset-paint.md) -->
      <Grid Grid.Row="1" VerticalAlignment="Bottom"
            HorizontalAlignment="{utu:Responsive Narrowest=Left, Wide=Center}"
            Margin="{utu:Responsive Narrowest='16,0,0,60', Narrow='40,0,0,64', Wide={StaticResource GapBottom16}}"
            Visibility="{x:Bind ViewModel.State.Stage.LayerSwitchShown, Mode=OneWay}">
      <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}">
        <!-- The HUD float shadow. Inline: a Style-supplied collection never applies (Toolkit gotcha G36). -->
        <utu:ShadowContainer.Shadows>
          <utu:ShadowCollection>
            <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
            <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
            <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.07" />
          </utu:ShadowCollection>
        </utu:ShadowContainer.Shadows>
        <Grid CornerRadius="{StaticResource RadiusGroup}" Padding="{StaticResource Inset2}">
          <!-- One ink pill slides and resizes to the current layer (DurationSlideMs on EaseSmooth) -->
          <controls:SegmentIndicator Host="{x:Bind LayerItems}" SelectedIndex="{x:Bind ViewModel.SelectedLayerIndex, Mode=OneWay}"
                                     Height="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource SurfaceInverseBrush}" />
          <ItemsControl IsTabStop="False" AutomationProperties.Name="Harbour layers" x:Name="LayerItems" ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LayerItem">
                <Button Style="{StaticResource BareButton}" Command="{x:Bind Command}" CommandParameter="{x:Bind Id}"
                        Height="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource TouchTarget}, Normal=40}" Padding="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest='11,0', Narrow={StaticResource InsetX14}}"
                        AutomationProperties.Name="{x:Bind Label}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                    <Viewbox Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" VerticalAlignment="Center">
                      <Grid Width="24" Height="24">
                        <shapes:Path Data="{x:Bind local:Paint.Icon(IconData)}" Stroke="{x:Bind local:MainPage.LayerIconInk(IsCurrent), Mode=OneWay}" StrokeThickness="1.6"
                                     StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      </Grid>
                    </Viewbox>
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource LabelLarge}" Foreground="{x:Bind local:MainPage.LayerInk(IsCurrent), Mode=OneWay}"
                               Visibility="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest=Collapsed, Narrow=Visible}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </utu:ShadowContainer>
      </Grid>

      <!-- Expand / Collapse: Overview's band grows to 491; elsewhere the strip opens to the full stage -->
      <utu:ShadowContainer Grid.Row="1" Background="{ThemeResource SurfaceBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{utu:Responsive Narrowest='0,12,16,0', Narrow='0,16,40,0'}"
                           Visibility="{x:Bind ViewModel.State.Stage.ShowToggle, Mode=OneWay}">
        <utu:ShadowContainer.Shadows>
          <utu:ShadowCollection>
            <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
            <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
            <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.07" />
          </utu:ShadowCollection>
        </utu:ShadowContainer.Shadows>
        <Button Style="{StaticResource HudSummaryButton}" Height="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" Padding="12,0,14,0"
                Command="{x:Bind ViewModel.State.Stage.ToggleCommand}"
                AutomationProperties.Name="{x:Bind ViewModel.Harbour.ToggleLabel, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <Viewbox Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" VerticalAlignment="Center">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{StaticResource ExpandIcon}" Stroke="{ThemeResource OnSurfaceBrush}"
                             Visibility="{x:Bind ViewModel.State.Stage.Collapsed, Mode=OneWay}" />
                <shapes:Path Style="{StaticResource CollapseIcon}" Stroke="{ThemeResource OnSurfaceBrush}"
                             Visibility="{x:Bind ViewModel.State.Stage.Expanded, Mode=OneWay}" />
              </Grid>
            </Viewbox>
            <TextBlock Text="{x:Bind ViewModel.Harbour.ToggleLabel, Mode=OneWay}" Style="{StaticResource LabelMedium}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </utu:ShadowContainer>
    </Grid>

    <!-- ══ SECTION ═════════════════════════════════════════════════════ -->
    <!-- Vertical only: every section reflows to the width it is given (App.xaml's size classes), so the page never
         scrolls sideways; wide tables and charts scroll inside their own cards on a phone -->
    <ScrollViewer AutomationProperties.Name="Section" x:Name="SectionScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
      <!-- Section region: one pane per route in App.RegisterRoutes. Each pane is x:Load'ed, so
           startup pays for the section you open on; the rest are realized one per idle turn after
           load (MainPage.WarmSections), and a jump to one not yet built realizes it on the spot
           (the navigator finds panes by name). x:Name and Region.Name are both the route id. -->
      <!-- SafeArea pads the end of the content clear of a phone's gesture or navigation bar (and a cutout on its side),
           so the last figures can scroll into view while the page ground still runs to the window's edge -->
      <Grid x:Name="Sections" uen:Region.Attached="True" uen:Region.Navigator="Visibility" utu:SafeArea.Insets="Left,Right,Bottom">
        <local:OverviewView x:Name="overview" x:Load="False" uen:Region.Name="overview" Visibility="Collapsed"
                            DataContext="{x:Bind ViewModel.Overview, Mode=OneWay}" />
        <local:BerthsView x:Name="berths" x:Load="False" uen:Region.Name="berths" Visibility="Collapsed"
                          DataContext="{x:Bind ViewModel.Berths, Mode=OneWay}" />
        <local:CargoView x:Name="cargo" x:Load="False" uen:Region.Name="cargo" Visibility="Collapsed"
                         DataContext="{x:Bind ViewModel.Cargo, Mode=OneWay}" />
        <local:FleetView x:Name="fleet" x:Load="False" uen:Region.Name="fleet" Visibility="Collapsed"
                         DataContext="{x:Bind ViewModel.Fleet, Mode=OneWay}" />
        <local:SecurityView x:Name="security" x:Load="False" uen:Region.Name="security" Visibility="Collapsed"
                            DataContext="{x:Bind ViewModel.Security, Mode=OneWay}" />
      </Grid>
    </ScrollViewer>

  </Grid>

  <!-- ══ CONTAINER INSPECTION ════════════════════════════════════════ -->
  <local:ScannerOverlay DataContext="{x:Bind ViewModel.Scanner, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Scanner.Camera.Open, Mode=OneWay, FallbackValue=Collapsed}" />
  </Grid>
</Page>
