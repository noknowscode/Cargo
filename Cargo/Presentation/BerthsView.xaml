<Page x:Class="Cargo.Presentation.BerthsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:Cargo.Controls">

  <!-- The decision waiting on you, what every berth holds, then the plan and the vessel you are working.
       Status and detail sit side by side from 1000 px and stack below it; the needs-you bar sits beside the title
       from 1280 and under it below -->
  <Grid Style="{StaticResource PageFrame}" Padding="{utu:Responsive Narrowest={StaticResource PagePaddingPhone}, Narrow={StaticResource PagePaddingTablet}, Normal={StaticResource PagePadding}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Below the breakpoint the needs-you bar takes its own full-width row under the title -->
    <Grid Style="{StaticResource Masthead}"
          RowSpacing="{utu:Responsive Narrowest={StaticResource Space200}, Wide=0}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel VerticalAlignment="Bottom" Spacing="{StaticResource Space100}">
        <TextBlock Text="Berths" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="North Quay · 8 berths · alongside depth 12.0 to 16.0 m" Style="{StaticResource PageSubtitleText}" />
        <controls:FlowPanel AutomationProperties.Name="Berth figures" Spacing="{StaticResource Space300}" RowSpacing="{StaticResource Space050}" Margin="{StaticResource Space075TopThickness}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <TextBlock Text="{x:Bind ViewModel.Alongside, Mode=OneWay}" Style="{StaticResource MetricText}" />
            <TextBlock Text="alongside" Style="{StaticResource MetricLabelText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <TextBlock Text="{x:Bind ViewModel.Arriving, Mode=OneWay}" Style="{StaticResource MetricText}" Foreground="{ThemeResource PrimaryBrush}" />
            <TextBlock Text="arriving" Style="{StaticResource MetricLabelText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <TextBlock Text="{x:Bind ViewModel.AtAnchor, Mode=OneWay}" Style="{StaticResource MetricText}" />
            <TextBlock Text="at anchor" Style="{StaticResource MetricLabelText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <TextBlock Text="{x:Bind ViewModel.Conflicts, Mode=OneWay}" Style="{StaticResource MetricText}" Foreground="{x:Bind local:BerthsView.ConflictInk(ViewModel.HasConflicts), Mode=OneWay}" />
            <TextBlock Text="conflicts in 36 h" Style="{StaticResource MetricLabelText}" />
          </StackPanel>
        </controls:FlowPanel>
      </StackPanel>

      <local:NeedsYouBar VerticalAlignment="Bottom"
                         Grid.Row="{utu:Responsive Narrowest=1, Wide=0}"
                         Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                         Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}"
                         Width="{utu:Responsive Narrowest=NaN, Wide=560}"
                         DataContext="{x:Bind ViewModel.NeedsYou, Mode=OneWay}" />
    </Grid>

    <!-- ── Berth status · Selected vessel ───────────────────────── -->
    <Grid Grid.Row="1"
          ColumnSpacing="{utu:Responsive Narrowest=0, Normal={StaticResource Space300}}"
          RowSpacing="{utu:Responsive Narrowest={StaticResource Space300}, Normal=0}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.55*" />
        <ColumnDefinition Width="{utu:Responsive Narrowest='0', Normal='1*'}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource SectionRule}">
        <StackPanel Spacing="{StaticResource Space125}">
          <Grid>
            <TextBlock Text="Berth status" Style="{StaticResource SectionHeadText}" />
            <TextBlock Text="{x:Bind ViewModel.Status.Count, Mode=OneWay}" Style="{StaticResource PageSubtitleText}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>

          <ItemsControl AutomationProperties.Name="Berth status" ItemsSource="{x:Bind ViewModel.Status.Rows, Mode=OneWay}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:BerthStatusRow">
                <Border BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="0,1">
                  <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Slot}"
                          controls:HoverLink.Command="{x:Bind Hover}" controls:HoverLink.Key="{x:Bind LinkKey, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <!-- xaml-lint: allow card - a list row whose ground and outline carry its state (needs you, selected) -->
                    <Border Padding="{StaticResource Space125Thickness}" CornerRadius="{StaticResource Radius100CornerRadius}" BorderThickness="2"
                            Background="{x:Bind local:BerthsView.RowGround(Kind, IsLinked), Mode=OneWay}" BorderBrush="{x:Bind local:BerthsView.RowOutline(Kind, IsCurrent, IsLinked), Mode=OneWay}">
                      <!-- Linked hover and the confirm recolour fade rather than switch -->
                      <Border.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.15" />
                      </Border.BackgroundTransition>
                      <Grid ColumnSpacing="{StaticResource Space150}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>

                        <!-- xaml-lint: allow card - the berth chip, the list's version of the harbour's painted number -->
                        <Border Width="34" Height="30" CornerRadius="{StaticResource Radius100CornerRadius}" BorderThickness="1"
                                Background="{x:Bind local:BerthsView.PlateGround(Kind), Mode=OneWay}" BorderBrush="{x:Bind local:BerthsView.PlateEdge(Kind), Mode=OneWay}">
                          <TextBlock Text="{x:Bind Plate, Mode=OneWay}" Style="{StaticResource PlateText}"
                                     Foreground="{x:Bind local:BerthsView.PlateInk(Kind), Mode=OneWay}" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space025}" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" Style="{StaticResource ListStateText}"
                                     Foreground="{x:Bind local:BerthsView.StateInk(Kind), Mode=OneWay}" />
                          <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource ListNameText}"
                                     Foreground="{x:Bind local:BerthsView.NameInk(Kind), Mode=OneWay}" />
                          <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource ListMetaText}" />
                        </StackPanel>

                        <!-- Countdowns roll each minute rather than swap -->
                        <controls:RollingText Grid.Column="2" Text="{x:Bind When, Mode=OneWay}" Style="{StaticResource ListTimeFigure}"
                                              Foreground="{x:Bind local:BerthsView.WhenInk(Kind), Mode=OneWay}" VerticalAlignment="Center" />

                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="{StaticResource CaptionSmallFontSize}" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                      </Grid>
                    </Border>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"
              Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
              Style="{StaticResource SectionRule}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{x:Bind ViewModel.Detail.Name, Mode=OneWay}">
        <StackPanel Spacing="{StaticResource Space200}">
          <Grid>
            <TextBlock Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}" Style="{StaticResource SectionHeadText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.Detail.Where, Mode=OneWay}" Style="{StaticResource PageSubtitleText}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>

          <StackPanel Spacing="{StaticResource Space100}">
            <TextBlock Text="{x:Bind ViewModel.Detail.StateLabel, Mode=OneWay}" Style="{StaticResource ListStateText}"
                       Foreground="{x:Bind local:BerthsView.DetailInk(ViewModel.Detail.NeedsYou, ViewModel.Detail.IsRestricted), Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
              <controls:RollingText Text="{x:Bind ViewModel.Detail.Big, Mode=OneWay}" Style="{StaticResource DetailFigure}"
                                    Foreground="{x:Bind local:BerthsView.DetailInk(ViewModel.Detail.NeedsYou, ViewModel.Detail.IsRestricted), Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.Detail.BigSub, Mode=OneWay}" Style="{StaticResource LeadText}"
                         VerticalAlignment="Bottom" Margin="{StaticResource Space075BottomThickness}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Detail.Note, Mode=OneWay}" Style="{StaticResource LeadText}" TextWrapping="WrapWholeWords" />
          </StackPanel>

          <!-- The cargo block collapses for a free berth; it sits with the facts in an unspaced
               panel and carries its own gap, since Spacing would still charge for it on Uno -->
          <StackPanel>
          <StackPanel Spacing="{StaticResource Space075}" Margin="{StaticResource Space200BottomThickness}" Visibility="{x:Bind ViewModel.Detail.HasCargo, Mode=OneWay}">
            <!-- Slides between ships (300 ms EaseSmooth) -->
            <ProgressBar controls:Slide.Value="{x:Bind ViewModel.Detail.CargoPercent, Mode=OneWay}" Maximum="100" Height="6" MinHeight="6" CornerRadius="{StaticResource Radius100CornerRadius}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" Background="{ThemeResource OutlineVariantBrush}"
                         AutomationProperties.Name="{x:Bind ViewModel.Detail.CargoLabel, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Detail.CargoLabel, Mode=OneWay}" Style="{StaticResource FactKeyText}" />
          </StackPanel>

          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Facts, Mode=OneWay}">
            <ItemsRepeater.Layout>
              <UniformGridLayout MaximumRowsOrColumns="2" ItemsStretch="Fill" MinColumnSpacing="16" MinRowSpacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="{StaticResource Space025}">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource FactKeyText}" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource FactValueText}" Foreground="{x:Bind local:Paint.Ink(Tone)}" />
                </StackPanel>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          </StackPanel>

          <Button AutomationProperties.Name="Show on map" Content="Show on map" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                  MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=40}"
                  Command="{x:Bind ViewModel.Detail.ShowOnMapCommand, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource SectionRule}">
      <local:DockingView DataContext="{x:Bind ViewModel.Plan, Mode=OneWay}" />
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SectionRule}">
      <local:VesselsView DataContext="{x:Bind ViewModel.Vessel, Mode=OneWay}" />
    </Border>
  </Grid>
</Page>
