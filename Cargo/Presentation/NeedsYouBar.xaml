<UserControl x:Class="Cargo.Presentation.NeedsYouBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!-- The one decision waiting on the dispatcher. A polite live region: the title and meta are
       announced as the bar moves from needs to done and back. -->
  <!-- xaml-lint: allow card - a status callout whose ground changes with its state (amber while it needs you, surface once done) -->
  <Border MinHeight="48" Padding="14,4,4,4" CornerRadius="{StaticResource RadiusPanel}"
          Background="{x:Bind local:NeedsYouBar.Ground(ViewModel.IsDone), Mode=OneWay}"
          BorderBrush="{x:Bind local:NeedsYouBar.Edge(ViewModel.IsDone), Mode=OneWay}" BorderThickness="1"
          controls:HoverLink.Command="{x:Bind ViewModel.HoverCommand, Mode=OneWay}"
          controls:HoverLink.Key="{x:Bind ViewModel.Subject, Mode=OneWay}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}">
    <!-- On a phone the actions drop under the text, which keeps the bar's width -->
    <Grid ColumnSpacing="{StaticResource Space12}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Needs: the alert square the app uses for every needs-you mark. Done: a check. -->
      <Grid VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
        <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource RadiusMark}" RadiusY="{StaticResource RadiusMark}" Fill="{ThemeResource ErrorBrush}"
                   Visibility="{x:Bind ViewModel.IsPending, Mode=OneWay}" />
        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource CaptionSmallFontSize}" Foreground="{ThemeResource OnSurfaceBrush}"
                  Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}" />
      </Grid>

      <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}" Padding="{StaticResource InsetY6}" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource ListNameText}" />
        <TextBlock Text="{x:Bind ViewModel.Meta, Mode=OneWay}" Style="{StaticResource ListMetaText}"
                   Foreground="{x:Bind local:NeedsYouBar.MetaInk(ViewModel.IsRefused), Mode=OneWay}" />
      </StackPanel>

      <!-- Margins, not Spacing: Spacing charges for the collapsed buttons on Uno -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                  Grid.Row="{utu:Responsive Narrowest=1, Narrow=0}" Grid.Column="{utu:Responsive Narrowest=1, Narrow=2}"
                  Grid.ColumnSpan="{utu:Responsive Narrowest=2, Narrow=1}"
                  Margin="{utu:Responsive Narrowest={StaticResource GapBottom8}, Narrow='0'}">
        <Button AutomationProperties.Name="Review the vessel" Content="Review" Style="{StaticResource GhostButton}" MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}"
                Command="{x:Bind ViewModel.ReviewCommand, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.CanReview, Mode=OneWay}" />
        <Button Style="{StaticResource PrimaryActionButton}" MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" MinWidth="148" Margin="{StaticResource GapStart4}"
                Command="{x:Bind ViewModel.ConfirmCommand, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsPending, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <ProgressRing Width="12" Height="12" MinWidth="12" MinHeight="12" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Foreground="{ThemeResource OnPrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}" Style="{StaticResource ActionLabelText}" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Undo the confirm" Content="Undo" Style="{StaticResource GhostButton}" MinHeight="{utu:Responsive Narrowest={StaticResource TouchTarget}, Normal=40}" Margin="{StaticResource GapStart4}"
                Command="{x:Bind ViewModel.UndoCommand, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
