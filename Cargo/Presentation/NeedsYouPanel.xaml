<UserControl x:Class="Cargo.Presentation.NeedsYouPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!-- The Needs-you queue: what waits on the dispatcher, each with the action that resolves it.
       The section is tinted alert while anything is open; empty, it keeps its height and says so.
       On a phone each action drops under its text, which keeps the width to wrap in. -->
  <Grid x:Name="Section" Padding="{utu:Responsive Narrowest='16,20,16,12', Narrow='24,24,24,16'}" CornerRadius="12,12,0,0"
        Background="{x:Bind local:NeedsYouPanel.Ground(ViewModel.Count), Mode=OneWay}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space10}">
      <TextBlock x:Name="Heading" Text="Needs you" Style="{StaticResource PanelHeadingText}" VerticalAlignment="Center"
                 IsTabStop="True" AutomationProperties.HeadingLevel="Level2"
                 AutomationProperties.Name="{x:Bind local:NeedsYouPanel.Spoken(ViewModel.Count), Mode=OneWay}" />
      <!-- xaml-lint: allow card - the count badge, a pill of mono digits -->
      <Border Background="{ThemeResource ErrorBrush}" CornerRadius="{StaticResource RadiusPanel}" Padding="{StaticResource Inset10x4}" VerticalAlignment="Center"
              Visibility="{x:Bind local:NeedsYouPanel.Shown(ViewModel.Count), Mode=OneWay}"
              AutomationProperties.AccessibilityView="Raw">
        <TextBlock Text="{x:Bind local:NeedsYouPanel.Count(ViewModel.Count), Mode=OneWay}" Style="{StaticResource CountBadgeText}" />
      </Border>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Nothing needs you" Style="{StaticResource SubtitleText}" Margin="{StaticResource GapTop16}"
               Visibility="{x:Bind local:NeedsYouPanel.Empty(ViewModel.Count), Mode=OneWay}" />

    <ItemsControl AutomationProperties.Name="Decisions waiting" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" Margin="{StaticResource GapTop4}" IsTabStop="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:DecisionRow">
          <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource InsetY16}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.AccessibilityView="Raw">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{x:Bind local:NeedsYouPanel.Icon(Decision.Kind)}" Stroke="{ThemeResource ErrorBrush}" />
              </Grid>
            </Viewbox>

            <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Decision.Title}" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource SubtitleText}" TextWrapping="Wrap">
                <Run Text="{x:Bind Decision.Sub}" /><Run Text="{x:Bind local:NeedsYouPanel.Separator(Decision.When), Mode=OneWay}" /><Run Text="{x:Bind Decision.When, Mode=OneWay}"
                     Foreground="{x:Bind local:NeedsYouPanel.WhenInk(Decision.IsLate), Mode=OneWay}"
                     FontWeight="{x:Bind local:NeedsYouPanel.WhenWeight(Decision.IsLate), Mode=OneWay}" />
              </TextBlock>
              <!-- Why the action was refused, in words; a polite live region, so it is announced -->
              <TextBlock Text="{x:Bind Decision.Refusal, Mode=OneWay}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"
                         Foreground="{ThemeResource ErrorBrush}" AutomationProperties.LiveSetting="Polite"
                         Visibility="{x:Bind local:NeedsYouPanel.Said(Decision.Refusal), Mode=OneWay}" />
            </StackPanel>

            <Button AutomationProperties.Name="{x:Bind Decision.ActionLabel}" Content="{x:Bind Decision.ActionLabel}" Style="{x:Bind local:NeedsYouPanel.Action(Decision.IsPrimary)}"
                    Command="{x:Bind Act}" CommandParameter="{x:Bind Decision}" VerticalAlignment="Center"
                    Grid.Row="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest=1, Narrow=0}" Grid.Column="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest=1, Narrow=2}"
                    HorizontalAlignment="Left" Margin="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrowest={StaticResource GapTop10}, Narrow='0'}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
