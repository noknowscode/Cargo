<UserControl x:Class="Cargo.Presentation.DockingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <!-- The berth plan. From 1280 one line of controls over the map and timeline, the selected vessel beside them;
       1000-1279 the scrubber takes its own line; below 1000 the vessel's panel follows the timeline and the map's
       hint sits under the map; below 600 every control takes its own line -->
  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Masthead ─────────────────────────────────────────────── -->
    <Grid ColumnSpacing="{StaticResource Space250}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="{StaticResource Space050}">
        <TextBlock Text="Berth plan" Style="{StaticResource SectionHeadText}" />
        <TextBlock Text="Next 36 hours · drag an arriving vessel onto a berth" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
      </StackPanel>
      <!-- The legend: the map's berth states and the timeline's conflict colour -->
      <controls:FlowPanel AutomationProperties.Name="Berth plan legend" Spacing="{StaticResource Space150}" RowSpacing="{StaticResource Space075}" VerticalAlignment="Bottom"
                          Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                          Margin="{utu:Responsive Narrowest={StaticResource Space125TopThickness}, Wide='0'}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource PrimaryBrush}" Opacity="0.35" VerticalAlignment="Center" />
          <TextBlock Text="Available" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Reserved" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Occupied" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Restricted" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
          <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Conflict" Style="{StaticResource CaptionText}" />
        </StackPanel>
      </controls:FlowPanel>
    </Grid>

    <!-- ── Scrubber ─────────────────────────────────────────────── -->
    <utu:CardContentControl AutomationProperties.Name="Plan controls" Style="{StaticResource PanelCard}" Grid.Row="1" Padding="{utu:Responsive Narrowest={StaticResource Inset16x12}, Narrow='18,12'}">
      <Grid ColumnSpacing="{StaticResource Space200}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}" VerticalAlignment="Center"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=4, Narrow=1}">
          <Button Style="{StaticResource GhostButton}" Content="Now" Padding="{StaticResource Inset12x7}"
                  MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}"
                  CornerRadius="{StaticResource Radius200CornerRadius}" Command="{x:Bind ViewModel.NowCommand, Mode=OneWay}"
                  Background="{x:Bind local:DockingView.NowGround(ViewModel.IsLive), Mode=OneWay}"
                  Foreground="{x:Bind local:DockingView.NowInk(ViewModel.IsLive), Mode=OneWay}"
                  AutomationProperties.Name="Back to now" />
          <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
            <Run Text="Viewing " /><Run Text="{x:Bind ViewModel.PlanLabel, Mode=OneWay}"
                                        FontFamily="{StaticResource MonoFontFamily}" FontWeight="Medium"
                                        Foreground="{ThemeResource OnSurfaceBrush}" />
          </TextBlock>
        </StackPanel>

        <Grid VerticalAlignment="Center"
              Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
              Grid.ColumnSpan="{utu:Responsive Narrowest=4, Wide=1}" Margin="{utu:Responsive Narrowest={StaticResource Space150TopThickness}, Wide='0'}">
          <Slider Style="{StaticResource ScrubSlider}" Minimum="0" Maximum="36"
                  StepFrequency="0.25" Margin="{StaticResource Space150BottomThickness}" AutomationProperties.Name="Plan time"
                  Value="{x:Bind ViewModel.Scrub, Mode=TwoWay}" />
          <Grid VerticalAlignment="Bottom" IsHitTestVisible="False">
            <TextBlock Text="00:00" Style="{StaticResource MicroText}" HorizontalAlignment="Left" />
            <TextBlock Text="12:00" Style="{StaticResource MicroText}" HorizontalAlignment="Center" />
            <TextBlock Text="Thu 12:00" Style="{StaticResource MicroText}" HorizontalAlignment="Right" />
          </Grid>
        </Grid>

        <!-- A polite live region: the conflict count changes after a drop, a move or Optimize -->
        <TextBlock Text="{x:Bind ViewModel.ConflictText, Mode=OneWay}" Style="{StaticResource CaptionText}"
                   Foreground="{x:Bind local:DockingView.ConflictInk(ViewModel.HasConflicts), Mode=OneWay}" VerticalAlignment="Center"
                   MaxWidth="360" HorizontalAlignment="Left" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                   Grid.Row="{utu:Responsive Narrowest=2, Wide=0}" Grid.Column="{utu:Responsive Narrowest=0, Wide=2}"
                   Grid.ColumnSpan="{utu:Responsive Narrowest=4, Wide=1}" Margin="{utu:Responsive Narrowest={StaticResource Space100TopThickness}, Wide='0'}" />

        <Button Style="{StaticResource PrimaryButton}" Command="{x:Bind ViewModel.OptimizeCommand, Mode=OneWay}" CornerRadius="{StaticResource Radius200CornerRadius}" Padding="14,8"
                AutomationProperties.Name="Optimize traffic"
                MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}" VerticalAlignment="Center"
                Grid.Row="{utu:Responsive Narrowest=3, Narrow=0}" Grid.Column="{utu:Responsive Narrowest=0, Narrow=3}"
                Grid.ColumnSpan="{utu:Responsive Narrowest=4, Narrow=1}"
                HorizontalAlignment="{utu:Responsive Narrowest=Stretch, Narrow=Right}"
                Margin="{utu:Responsive Narrowest={StaticResource Space150TopThickness}, Narrow='0'}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" HorizontalAlignment="Center">
            <shapes:Path Data="M4 17l5-5 4 4 7-8M15 8h5v5" Stroke="{ThemeResource OnSurfaceInverseBrush}" StrokeThickness="2"
                         Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Optimize traffic" Style="{StaticResource LabelMedium}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
          </StackPanel>
        </Button>
      </Grid>
    </utu:CardContentControl>

    <!-- ── Map, timeline and vessel panel ───────────────────────── -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Spacing="{StaticResource Space200}">
        <!-- The hint (what a drag will do, and why a drop was refused) floats over the map's water from 1000 px;
             on a narrower map it would cover the berths, so it sits under it -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <utu:CardContentControl AutomationProperties.Name="Berth map" Style="{StaticResource OutlinedPanel}" Padding="0"
                                  CornerRadius="{StaticResource Radius400CornerRadius}" Background="{ThemeResource LandBrush}">
            <ContentControl x:Name="MapHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
          </utu:CardContentControl>
          <utu:CardContentControl Style="{StaticResource OutlinedPanel}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"
                                  Margin="{utu:Responsive Narrowest={StaticResource Space100TopThickness}, Normal={StaticResource Space200Thickness}}" Padding="{StaticResource Inset12x8}" CornerRadius="{StaticResource Radius200CornerRadius}">
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </utu:CardContentControl>
        </Grid>

        <utu:CardContentControl AutomationProperties.Name="Berth timeline, 36 hours" Style="{StaticResource PanelCard}" Padding="{utu:Responsive Narrowest='16,16,16,14', Narrow='22,20,22,18'}">
          <StackPanel Spacing="{StaticResource Space150}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Berth timeline · 36 h" Style="{StaticResource CardTitleText}" />
              <TextBlock Text="Dashed edge: reserved for an arrival · red with an ink edge: two vessels overlap"
                         Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                         Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" HorizontalAlignment="{utu:Responsive Narrowest=Left, Wide=Right}"
                         Margin="{utu:Responsive Narrowest={StaticResource Space050TopThickness}, Wide='0'}" />
            </Grid>
            <Grid ColumnSpacing="{StaticResource Space150}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="1">
                <TextBlock Text="00:00" Style="{StaticResource MicroText}" HorizontalAlignment="Left" />
                <TextBlock Text="12:00" Style="{StaticResource MicroText}" HorizontalAlignment="Center" />
                <TextBlock Text="Thu 12:00" Style="{StaticResource MicroText}" HorizontalAlignment="Right" />
              </Grid>
            </Grid>
            <ItemsControl AutomationProperties.Name="Berth timeline rows" ItemsSource="{x:Bind ViewModel.PlanRows, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Space100}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PlanRow">
                  <Grid ColumnSpacing="{StaticResource Space150}" AutomationProperties.Name="{x:Bind AccessibleName}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Berth}" Style="{StaticResource TypeMonoMedium12}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    <!-- xaml-lint: allow card - the track of a timeline bar, not a card -->
                    <Border Grid.Column="1" Height="26" CornerRadius="{StaticResource Radius200CornerRadius}" Background="{ThemeResource SurfaceVariantBrush}">
                      <controls:ProportionalPanel Segments="{x:Bind Segments}" NowFraction="{x:Bind NowFraction, Mode=OneWay}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>

      <!-- ── Selected vessel ──────────────────────────────────────── -->
      <utu:CardContentControl AutomationProperties.Name="{x:Bind ViewModel.SelectedName, Mode=OneWay}" x:Name="SelectedPanel" Style="{StaticResource PanelCard}" Padding="{StaticResource Space250Thickness}" VerticalAlignment="Top"
                              Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                              Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                              Width="{utu:Responsive Narrowest=NaN, Normal=320}"
                              Margin="{utu:Responsive Narrowest={StaticResource Space200TopThickness}, Normal={StaticResource Space200LeftThickness}}">
        <StackPanel Spacing="{StaticResource Space150}">
          <Grid ColumnSpacing="{StaticResource Space100}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource Space050}">
              <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" Style="{StaticResource TitleLarge}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.SelectedStatus, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Content="×" Command="{x:Bind ViewModel.ClearSelectionCommand, Mode=OneWay}"
                    MinWidth="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}"
                    MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=32}"
                    AutomationProperties.Name="Clear selection" ToolTipService.ToolTip="Clear selection" />
          </Grid>

          <!-- xaml-lint: allow card - clips the vessel profile image -->
          <Border CornerRadius="{StaticResource Radius300CornerRadius}" Background="{ThemeResource SurfaceBrush}">
            <Grid Height="120">
              <Rectangle Fill="{ThemeResource SeaFlatBrush}" Height="16" VerticalAlignment="Bottom" />
              <Image Source="{x:Bind local:DockingView.Profile(ViewModel.SelectedProfile), Mode=OneWay}" Stretch="Uniform" Margin="18,6,18,10"
                     AutomationProperties.AccessibilityView="Raw" />
            </Grid>
          </Border>

          <ItemsControl AutomationProperties.Name="Selected vessel facts" ItemsSource="{x:Bind ViewModel.SelectedFacts, Mode=OneWay}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="{StaticResource Space150}" RowSpacing="{StaticResource Space150}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="{StaticResource Space050}">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongLargeText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
          <TextBlock Text="{x:Bind ViewModel.SelectedNote, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                     TextWrapping="Wrap" LineHeight="19" />

          <!-- Drag-to-assign without a drag: every berth, with what it says about this vessel. The keyboard and
               touch path to the same rules; a refused choice shows its reason in the hint, as a refused drop does -->
          <StackPanel Spacing="{StaticResource Space100}" Visibility="{x:Bind ViewModel.CanMove, Mode=OneWay}">
            <TextBlock Text="Move to berth" Style="{StaticResource MicroText}" />
            <ItemsControl AutomationProperties.Name="Move to berth" ItemsSource="{x:Bind ViewModel.BerthChoices, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:TileGridPanel MinTileWidth="80" Gap="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:BerthChoice">
                  <Button Style="{StaticResource GhostButton}" Command="{x:Bind Assign}" CommandParameter="{x:Bind Number}"
                          BorderBrush="{x:Bind local:DockingView.ChoiceEdge(Fits), Mode=OneWay}" Padding="{StaticResource Space075Thickness}" CornerRadius="{StaticResource Radius200CornerRadius}" HorizontalAlignment="Stretch"
                          MinHeight="{StaticResource ControlHeightMediumLarge}"
                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind AccessibleName, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space025}" HorizontalAlignment="Center">
                      <TextBlock Text="{x:Bind Number}" Style="{StaticResource TypeMonoMedium13}" Foreground="{ThemeResource OnSurfaceBrush}"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource LabelExtraSmall}"
                                 Foreground="{x:Bind local:DockingView.ChoiceInk(Fits), Mode=OneWay}"
                                 HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button AutomationProperties.Name="Release berth" Style="{StaticResource GhostButton}" Content="Release berth"
                  MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}"
                  Command="{x:Bind ViewModel.ReleaseCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                  Visibility="{x:Bind ViewModel.CanRelease, Mode=OneWay}" />
          <Button AutomationProperties.Name="Open vessel profile" Style="{StaticResource PrimaryButton}" Content="Vessel profile →" Command="{x:Bind ViewModel.OpenProfileCommand, Mode=OneWay}"
                  MinHeight="{utu:Responsive Narrowest={StaticResource ControlHeightMediumLarge}, Normal=0}"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </utu:CardContentControl>
    </Grid>
  </Grid>
</UserControl>
