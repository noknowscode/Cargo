<!--
  Layout values the theme has no token for. Spacing, radius and control sizes come from the Simple theme's tokens
  (Space*, Space*Thickness and their Horizontal/Vertical/Top/Bottom/Left forms, Radius*CornerRadius,
  ControlHeight*, IconSize*), generated from DefaultSpacing (8) and DefaultCornerRadius (4) on the theme in App.xaml.
  What stays here: the two-axis insets of chips and badges whose axes differ by more than one step, the ruled panels'
  inset, every section page's frame per size class, and the legend swatch. Literals here, not references: this
  dictionary sits beside the theme in App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Chip and badge insets, h left and right, v top and bottom -->
  <Thickness x:Key="Inset8x3">8,3</Thickness>
  <Thickness x:Key="Inset10x4">10,4</Thickness>
  <Thickness x:Key="Inset12x7">12,7</Thickness>
  <Thickness x:Key="Inset12x8">12,8</Thickness>
  <Thickness x:Key="Inset14x7">14,7</Thickness>
  <Thickness x:Key="Inset16x12">16,12</Thickness>

  <!-- The ruled panels (a 2 px ink rule on top), some with room at the end -->
  <Thickness x:Key="RuledPanelInset">0,18,0,14</Thickness>
  <Thickness x:Key="RuledPanelInsetEnd">0,18,20,14</Thickness>
  <!-- Every section page shares one frame: its padding per size class (App.xaml's DefaultResponsiveLayout) -->
  <Thickness x:Key="PagePaddingPhone">16,20,16,32</Thickness>
  <Thickness x:Key="PagePaddingTablet">24,24,24,40</Thickness>
  <Thickness x:Key="PagePadding">40,28,40,48</Thickness>

  <!-- A tinted section at the top of a card (Needs you): the panel radius on the top corners only, which no
       Radius*CornerRadius token says -->
  <CornerRadius x:Key="PanelTopCornerRadius">12,12,0,0</CornerRadius>

  <!-- A legend swatch or a needs-you mark -->
  <x:Double x:Key="SwatchSize">10</x:Double>

</ResourceDictionary>
