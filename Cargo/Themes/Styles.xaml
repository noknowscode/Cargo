<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:controls="using:Cargo.Controls">

  <!-- ============================================================
       Type ramp
       Display type is Bricolage Grotesque; UI text Archivo; every
       figure that has to line up in a column is IBM Plex Mono.
       Sizes come from the design ramp only: 11 12 13 14 15 18 20 24 30 40
       (docs/design/overview-timeline/EXTRACTION.md §1 Fonts).

       Type* styles set family and size and nothing else, so the text keeps
       the colour it inherits (a label inside a button stays the button's
       colour). The role styles further down add their colour.
       ============================================================ -->

  <Style x:Key="TypeBody11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="TypeBody12" TargetType="TextBlock" BasedOn="{StaticResource TypeBody11}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="TypeBody13" TargetType="TextBlock" BasedOn="{StaticResource TypeBody11}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="TypeBody14" TargetType="TextBlock" BasedOn="{StaticResource TypeBody11}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="TypeBody15" TargetType="TextBlock" BasedOn="{StaticResource TypeBody11}">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="TypeMedium11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="TypeMedium12" TargetType="TextBlock" BasedOn="{StaticResource TypeMedium11}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="TypeMedium13" TargetType="TextBlock" BasedOn="{StaticResource TypeMedium11}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="TypeMedium14" TargetType="TextBlock" BasedOn="{StaticResource TypeMedium11}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="TypeMedium15" TargetType="TextBlock" BasedOn="{StaticResource TypeMedium11}">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="TypeStrong11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="TypeStrong12" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="TypeStrong13" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="TypeStrong14" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="TypeStrong15" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style x:Key="TypeStrong18" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style x:Key="TypeStrong20" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style x:Key="TypeMono11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="TypeMono12" TargetType="TextBlock" BasedOn="{StaticResource TypeMono11}">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="TypeMono13" TargetType="TextBlock" BasedOn="{StaticResource TypeMono11}">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="TypeMonoMedium11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="TypeMonoMedium12" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="TypeMonoMedium13" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="TypeMonoMedium14" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="TypeMonoMedium18" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style x:Key="TypeMonoMedium20" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style x:Key="TypeMonoMedium24" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="FontSize" Value="24" />
  </Style>

  <Style x:Key="TypeDisplay15" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style x:Key="GreetingText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- A page title wraps on a phone ("Fleet & waterways" is wider than 328 px at 40) -->
  <Style x:Key="PageTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="EyebrowText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
  </Style>

  <Style x:Key="CardTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="PanelTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <!-- Role styles at the ramp's in-between steps: the role's colour on a Type* size -->
  <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource TypeBody13}">
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>
  <Style x:Key="BodySmallText" TargetType="TextBlock" BasedOn="{StaticResource TypeBody12}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="BodyLargeText" TargetType="TextBlock" BasedOn="{StaticResource TypeBody14}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="BodyStrongSmallText" TargetType="TextBlock" BasedOn="{StaticResource TypeMedium12}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="BodyStrongLargeText" TargetType="TextBlock" BasedOn="{StaticResource TypeMedium14}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong15}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="MicroText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource TextFaintBrush}" />
  </Style>

  <!-- Headline figures: Archivo 600 (the design keeps Bricolage for the wordmark and headings) -->
  <Style x:Key="MetricText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- Status lists (Berths): a caps state line, the name, a muted meta line, a mono time -->
  <Style x:Key="ListStateText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <Style x:Key="ListNameText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="ListMetaText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="ListTimeFigure" TargetType="controls:RollingText">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- The berth chip: the list's version of the harbour's painted number -->
  <Style x:Key="PlateText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Detail panels: one big figure, lead text, facts as a muted key over a mono value -->
  <Style x:Key="DetailFigure" TargetType="controls:RollingText">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="LeadText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <Style x:Key="FactKeyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <Style x:Key="FactValueText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="ActionLabelText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Header clock: minutes roll, seconds tick plainly -->
  <Style x:Key="HeaderClockFigure" TargetType="controls:RollingText">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="HeaderClockText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium14}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- The header wordmark: the design's one size off the ramp -->
  <Style x:Key="WordmarkText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- Masthead: the date under the greeting and the duty operator's ID card -->
  <Style x:Key="DateLineText" TargetType="TextBlock" BasedOn="{StaticResource TypeBody15}">
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <Style x:Key="CardNameText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong14}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="BadgeMonoText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <Style x:Key="CardInitialsText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong13}">
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Panel headings on Overview (Today at North Quay, Needs you, Next 6 h, Activity): 18/600 -->
  <Style x:Key="PanelHeadingText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong18}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- A count badge: mono on alert ink (SemiBold in the design; Medium until the SemiBold face ships) -->
  <Style x:Key="CountBadgeText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium13}">
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
  </Style>

  <Style x:Key="AvatarInitialsText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong12}">
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================
       Cards — Toolkit CardContentControl, tuned by lightweight keys.
       PanelCard: surface, hairline edge, elevation (the section panels).
       OutlinedPanel: hairline only, for cards inside a panel or a row.
       Both stretch like the old Card did (the Toolkit base does not).
       These panels are static, so pointer-over keeps the resting fill:
       a hover tint on a panel reads as "this is clickable". The fills are
       the Toolkit's lightweight keys, set per theme in Tokens.xaml.
       ============================================================ -->
  <Style x:Key="PanelCard" TargetType="utu:CardContentControl" BasedOn="{StaticResource ElevatedCardContentControlStyle}">
    <Setter Property="Padding" Value="{StaticResource CardInset}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- The Simple template reads BorderBrush from the control; the ElevatedCardContentBorderBrush key had no effect -->
    <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style x:Key="OutlinedPanel" TargetType="utu:CardContentControl" BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <Setter Property="Padding" Value="{StaticResource Inset16x14}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <!-- ============================================================
       Page template — every section page follows the Overview:
       one frame, a masthead over a hairline, then flat ruled sections.
       ============================================================ -->
  <!-- No minimum width: each page sets its padding per size class and reflows below 1280 (App.xaml). From 1600 the
       1520 cap centres it (a stretched element with a MaxWidth sits in the middle of the space) -->
  <Style x:Key="PageFrame" TargetType="Grid">
    <Setter Property="Padding" Value="{StaticResource PagePadding}" />
    <Setter Property="MaxWidth" Value="1520" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="RowSpacing" Value="{StaticResource Space28}" />
  </Style>

  <Style x:Key="Masthead" TargetType="Grid">
    <Setter Property="BorderBrush" Value="{ThemeResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{StaticResource GapBottom18}" />
    <Setter Property="ColumnSpacing" Value="{StaticResource Space24}" />
  </Style>

  <!-- A part of a page (Berths hosts the plan and the vessel; Cargo the explorer and the yard) -->
  <Style x:Key="SectionFrame" TargetType="Grid">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="RowSpacing" Value="{StaticResource Space18}" />
  </Style>

  <!-- Each part starts under a 2px ink rule, like the Overview's panels -->
  <Style x:Key="SectionRule" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="{StaticResource GapTop18}" />
  </Style>

  <Style x:Key="SectionHeadText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <Style x:Key="PageSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Masthead figures: a number and what it counts, baseline-aligned -->
  <!-- A headline figure: its label above, the number below, left-aligned on one edge -->
  <Style x:Key="FigureStack" TargetType="StackPanel">
    <Setter Property="Spacing" Value="{StaticResource Space4}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <Style x:Key="FigureLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MetricLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="{StaticResource GapBottom4}" />
  </Style>

  <!-- Status as a dot and a word; the word takes the ink variant of the status colour -->
  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Flat panel: the overview uses a 2px ink rule instead of a box -->
  <Style x:Key="RuledPanel" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="{StaticResource RuledPanelInset}" />
  </Style>

  <!-- ============================================================
       Buttons
       ============================================================ -->

  <!-- Own template: the design fades the whole button on hover, press and disable (one root's Opacity, content
       included); the theme's lightweight keys swap per-state brushes and cannot fade content -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource InkBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource PaperBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.88" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.78" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{ThemeResource SurfaceSunkBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The primary action on a light ground: accent with white text -->
  <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
  </Style>

  <!-- The primary action on a dark ground (the scanner stage) -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource AccentBrightInvariantBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkDeepInvariantBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
  </Style>

  <!-- Transparent hit target: rows, cards, map furniture. Own template: no chrome at all, so selectable rows keep
       their own, and the hover is a fade of the content, which lightweight brush keys cannot express -->
  <Style x:Key="BareButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.82" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Header tab: the content draws the label and the active 2px accent line; the template adds
       the hover state, which inks the label and shows the line at 16% ink. Own template: the hover line is an
       element the theme's Button template does not have -->
  <Style x:Key="NavTabButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="56" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}">
            <Rectangle x:Name="HoverLine" Height="2" VerticalAlignment="Bottom" Opacity="0"
                       Fill="{ThemeResource TabHoverBrush}" />
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLine.Opacity" Value="1" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource InkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLine.Opacity" Value="1" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource InkBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- HUD float buttons: transparent inside their ShadowContainer, ink text, the bare button's hover fade -->
  <Style x:Key="HudSummaryButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="16,0,14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style x:Key="HudIconButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Caps labels (Key header, lane labels, table heads): 11/600 muted -->
  <Style x:Key="CapsLabelText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
  </Style>

  <Style x:Key="KeyRowText" TargetType="TextBlock" BasedOn="{StaticResource TypeBody13}">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Needs-you queue actions: 44 px, radius 8, 14 px; the queue's one primary in accent, the rest
       on the surface with an 18% ring -->
  <Style x:Key="QueuePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="{StaticResource InsetX16}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="QueueSecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="{StaticResource InsetX16}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- A segment of a two-way toggle (Chart / Table): 72x40, 13 px, over a SegmentIndicator -->
  <Style x:Key="ToggleSegmentButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="40" />
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The × that closes a detail panel, top-right of its header: a 32 px target (44 where pages ask for touch) -->
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The same × as a round button on the dark scanner stage -->
  <Style x:Key="CloseOnDarkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{StaticResource HairlineOnDarkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineOnDarkBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextOnDarkStrongBrush}" />
  </Style>

  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- ============================================================
       Harbour stage HUD — flat surface chips over the 3D scene
       ============================================================ -->
  <!-- Slider used by the docking timeline scrubber -->
  <Style x:Key="ScrubSlider" TargetType="Slider">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="Background" Value="{ThemeResource SurfaceSunkAltBrush}" />
    <Setter Property="IsThumbToolTipEnabled" Value="False" />
  </Style>

</ResourceDictionary>
