<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:controls="using:Cargo.Controls">

  <!-- ============================================================
       Type
       The theme's semantic text styles (DisplayLarge ... CaptionSmall) carry the design's ramp, set once in
       Styles/TypographyOverride.xaml over DefaultFontFamily (Archivo). Pages use them directly. The styles below add
       only what a semantic style does not say: a heavier weight at a small size, the mono face for figures that line
       up in a column, the display face at 15, and a role's colour.

       The Type* styles set no colour, so the text keeps the colour it inherits (a label inside a button stays the
       button's colour). The role styles further down add their colour.
       ============================================================ -->

  <!-- Archivo SemiBold at the small sizes: caps labels, list states, initials, action labels -->
  <Style x:Key="TypeStrong11" TargetType="TextBlock" BasedOn="{StaticResource LabelExtraSmall}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TypeStrong12" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TypeStrong13" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TypeMedium15" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- IBM Plex Mono for every figure that lines up: Regular at 11-13, Medium at 11-24 -->
  <Style x:Key="TypeMono11" TargetType="TextBlock" BasedOn="{StaticResource CaptionSmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMono12" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMono13" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMonoMedium11" TargetType="TextBlock" BasedOn="{StaticResource LabelExtraSmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMonoMedium12" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMonoMedium13" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMonoMedium14" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
  </Style>
  <Style x:Key="TypeMonoMedium15" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="TypeMonoMedium18" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="TypeMonoMedium20" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="TypeMonoMedium24" TargetType="TextBlock" BasedOn="{StaticResource DisplaySmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Bricolage Grotesque at 15: card titles -->
  <Style x:Key="TypeDisplay15" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
  </Style>

  <!-- ── Role styles: a semantic style and its colour ─────────── -->
  <!-- The greeting and page titles: DisplayLarge on a 44 line. A page title wraps on a phone ("Fleet & waterways" is
       wider than 328 px at 40) -->
  <Style x:Key="GreetingText" TargetType="TextBlock" BasedOn="{StaticResource DisplayLarge}">
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>
  <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource DisplayLarge}">
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
  </Style>

  <Style x:Key="CardTitleText" TargetType="TextBlock" BasedOn="{StaticResource TypeDisplay15}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="PanelTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>
  <Style x:Key="BodySmallText" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>
  <Style x:Key="BodyLargeText" TargetType="TextBlock" BasedOn="{StaticResource CaptionLarge}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>
  <Style x:Key="BodyStrongSmallText" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>
  <Style x:Key="BodyStrongLargeText" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>
  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="MicroText" TargetType="TextBlock" BasedOn="{StaticResource CaptionSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <!-- Headline figures: Archivo 600 on a tight line (the design keeps Bricolage for the wordmark and headings) -->
  <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource HeadlineLarge}">
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- Status lists (Berths): a caps state line, the name, a muted meta line, a mono time -->
  <Style x:Key="ListStateText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="ListNameText" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="ListMetaText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- RollingText is a control, not a TextBlock: its figures take the ramp's keys directly -->
  <Style x:Key="ListTimeFigure" TargetType="controls:RollingText">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelMediumFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- The berth chip: the list's version of the harbour's painted number -->
  <Style x:Key="PlateText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium13}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Detail panels: one big figure, lead text, facts as a muted key over a mono value -->
  <Style x:Key="DetailFigure" TargetType="controls:RollingText">
    <Setter Property="FontFamily" Value="{StaticResource DisplayMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource DisplayMediumFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="LeadText" TargetType="TextBlock" BasedOn="{StaticResource CaptionLarge}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="FactKeyText" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="FactValueText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium15}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="ActionLabelText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong13}" />

  <!-- Header clock: minutes roll, seconds tick plainly -->
  <Style x:Key="HeaderClockFigure" TargetType="controls:RollingText">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="HeaderClockText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium14}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- The header wordmark: the design's one size off the ramp (HeadlineSmall, 19) -->
  <Style x:Key="WordmarkText" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- Masthead: the date under the greeting and the duty operator's ID card -->
  <Style x:Key="DateLineText" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="CardNameText" TargetType="TextBlock" BasedOn="{StaticResource TitleSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="BadgeMonoText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium11}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="CardInitialsText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong13}">
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Panel headings on Overview (Today at North Quay, Needs you, Next 6 h, Activity): 18/600 -->
  <Style x:Key="PanelHeadingText" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- A count badge: mono on the error ground (SemiBold in the design; Medium until the SemiBold face ships) -->
  <Style x:Key="CountBadgeText" TargetType="TextBlock" BasedOn="{StaticResource TypeMonoMedium13}">
    <Setter Property="Foreground" Value="{ThemeResource OnErrorBrush}" />
  </Style>

  <Style x:Key="AvatarInitialsText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong12}">
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================
       Cards — Toolkit CardContentControl, tuned by lightweight keys.
       PanelCard: SurfaceBrush, an OutlineVariant edge, elevation (the section panels).
       OutlinedPanel: the edge only, for cards inside a panel or a row.
       Both stretch to their column (the Toolkit base does not).
       These panels are static, so pointer-over keeps the resting fill:
       a hover tint on a panel reads as "this is clickable" (the Toolkit's
       CardContentBackgroundPointerOver key is SurfaceBrush in App.xaml).
       ============================================================ -->
  <Style x:Key="PanelCard" TargetType="utu:CardContentControl" BasedOn="{StaticResource ElevatedCardContentControlStyle}">
    <Setter Property="Padding" Value="{StaticResource Space250Thickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius400CornerRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- The Simple template reads BorderBrush from the control; the ElevatedCardContentBorderBrush key had no effect -->
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style x:Key="OutlinedPanel" TargetType="utu:CardContentControl" BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <Setter Property="Padding" Value="{StaticResource Space200Thickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius300CornerRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <!-- ============================================================
       Page template — every section page follows the Overview:
       one frame, a masthead over a hairline, then flat ruled sections.
       ============================================================ -->
  <!-- No minimum width: each page sets its padding per size class and reflows below 1280 (App.xaml). From 1600 the
       1520 cap centres it (a stretched element with a MaxWidth sits in the middle of the space) -->
  <Style x:Key="PageFrame" TargetType="Grid">
    <Setter Property="Padding" Value="{StaticResource PagePadding}" />
    <Setter Property="MaxWidth" Value="1520" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="RowSpacing" Value="{StaticResource Space300}" />
  </Style>

  <Style x:Key="Masthead" TargetType="Grid">
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{StaticResource Space200BottomThickness}" />
    <Setter Property="ColumnSpacing" Value="{StaticResource Space300}" />
  </Style>

  <!-- A part of a page (Berths hosts the plan and the vessel; Cargo the explorer and the yard) -->
  <Style x:Key="SectionFrame" TargetType="Grid">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="RowSpacing" Value="{StaticResource Space200}" />
  </Style>

  <!-- Each part starts under a 2px ink rule, like the Overview's panels -->
  <Style x:Key="SectionRule" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="{StaticResource Space200TopThickness}" />
  </Style>

  <Style x:Key="SectionHeadText" TargetType="TextBlock" BasedOn="{StaticResource DisplaySmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style x:Key="PageSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource CaptionLarge}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <!-- Masthead figures: a number and what it counts, baseline-aligned -->
  <!-- A headline figure: its label above, the number below, left-aligned on one edge -->
  <Style x:Key="FigureStack" TargetType="StackPanel">
    <Setter Property="Spacing" Value="{StaticResource Space050}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <Style x:Key="FigureLabelText" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MetricLabelText" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="{StaticResource Space050BottomThickness}" />
  </Style>

  <!-- Status as a dot and a word; the word takes the ink variant of the status colour -->
  <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Flat panel: the overview uses a 2px ink rule instead of a box -->
  <Style x:Key="RuledPanel" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="{StaticResource RuledPanelInset}" />
  </Style>

  <!-- ============================================================
       Buttons
       ============================================================ -->

  <!-- The ink button: the inverse surface (SurfaceInverse with OnSurfaceInverse), the design's main page action.
       Own template: the theme has no inverse filled button, and its filled template's hover keys are the Primary
       variants, so the design's fade of the whole button on hover, press and disable (one root's Opacity, content
       included) stays -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SurfaceInverseBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceInverseBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource LabelMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelMediumFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="{StaticResource Space150Thickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.88" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.78" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The secondary action: the theme's tonal button (SurfaceVariant, an Outline edge, OnSurface text; its hover and
       press are the theme's state colours), at the design's size -->
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FilledTonalButtonStyle}">
    <Setter Property="FontSize" Value="{StaticResource LabelMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource Space150Thickness}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- The accent action: the theme's filled button (Primary with OnPrimary), at the design's size -->
  <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource FilledButtonStyle}">
    <Setter Property="FontSize" Value="{StaticResource LabelMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource Space150Thickness}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- The accent action on the scanner's stage (the Dark theme in both themes), in the strong weight -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Transparent hit target: rows, cards, map furniture. Own template: no chrome at all, so selectable rows keep
       their own, and the hover is a fade of the content, which lightweight brush keys cannot express -->
  <Style x:Key="BareButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.82" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Header tab: the content draws the label and the active 2px accent line; the template adds
       the hover state, which inks the label and shows the line at 16% ink. Own template: the hover line is an
       element the theme's Button template does not have -->
  <Style x:Key="NavTabButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="56" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}">
            <Rectangle x:Name="HoverLine" Height="2" VerticalAlignment="Bottom" Opacity="0"
                       Fill="{ThemeResource OutlineBrush}" />
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLine.Opacity" Value="1" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLine.Opacity" Value="1" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- HUD float buttons: transparent inside their ShadowContainer, ink text, the bare button's hover fade -->
  <Style x:Key="HudSummaryButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="Padding" Value="{StaticResource Space200HorizontalThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="FontFamily" Value="{StaticResource LabelLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style x:Key="HudIconButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Caps labels (Key header, lane labels, table heads): 11/600 muted -->
  <Style x:Key="CapsLabelText" TargetType="TextBlock" BasedOn="{StaticResource TypeStrong11}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="KeyRowText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Needs-you queue actions: 44 px, radius 8, 14 px; the queue's one primary in accent, the rest
       on the surface with an 18% ring -->
  <Style x:Key="QueuePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="Padding" Value="{StaticResource Space200HorizontalThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="FontSize" Value="{StaticResource LabelLargeFontSize}" />
  </Style>

  <Style x:Key="QueueSecondaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="Padding" Value="{StaticResource Space200HorizontalThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="FontSize" Value="{StaticResource LabelLargeFontSize}" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
  </Style>

  <!-- A segment of a two-way toggle (Chart / Table): 72x40, 13 px, over a SegmentIndicator -->
  <Style x:Key="ToggleSegmentButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="{StaticResource ControlHeightMedium}" />
    <Setter Property="FontFamily" Value="{StaticResource LabelMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelMediumFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The × that closes a detail panel, top-right of its header: a 32 px target (44 where pages ask for touch) -->
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="FontFamily" Value="{StaticResource TitleLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TitleLargeFontSize}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="MinWidth" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The same × as a round tonal button on the scanner's stage (the Dark theme in both themes) -->
  <Style x:Key="CloseOnDarkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="FontSize" Value="{StaticResource TitleLargeFontSize}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFullCornerRadius}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- ============================================================
       Harbour stage HUD — flat surface chips over the 3D scene
       ============================================================ -->
  <!-- Slider used by the docking timeline scrubber: an ink value on a sunk track -->
  <Style x:Key="ScrubSlider" TargetType="Slider">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
    <Setter Property="IsThumbToolTipEnabled" Value="False" />
  </Style>

</ResourceDictionary>
