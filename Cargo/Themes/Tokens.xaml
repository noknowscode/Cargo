      <!-- Harbour scene (3D stage): the ground, water and light. Light is the high-key daytime miniature; Dark is the same model at night -->
      <Color x:Key="HarbourStageColor">#FFEDF0F1</Color>
      <!-- A lit face: the night light level (below) dims it to about #252B2F -->
