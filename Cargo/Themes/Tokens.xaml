      <Color x:Key="HarbourSignColor">#FF464E54</Color>

      <!-- Shadows -->
      <!-- The 1 px ring under a float (Spread 1, no blur): an ink edge on Light, a light edge on Dark -->
      <Color x:Key="ShadowRingColor">#FF121617</Color>

      <!-- Scales every lit face of the 3D model (paint colours stay invariant): daylight, then night -->
      <x:Double x:Key="HarbourLightLevel">1</x:Double>
      <!-- How far a model's top edges lift toward white -->
      <x:Double x:Key="HarbourEdgeLift">0.42</x:Double>

      <!-- Brushes. Pages use {ThemeResource} for every one; code gets them from Domain/Tokens, which recolours them in place -->
