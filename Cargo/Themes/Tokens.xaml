      <SolidColorBrush x:Key="LandBrush" Color="{StaticResource LandColor}" />
      <SolidColorBrush x:Key="RoadBrush" Color="{StaticResource RoadColor}" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
      <SolidColorBrush x:Key="TextInverseMutedBrush" Color="{StaticResource TextInverseMutedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
      <SolidColorBrush x:Key="WaterBrush" Color="{StaticResource WaterColor}" />
      <SolidColorBrush x:Key="SeaGreenBrush" Color="{StaticResource SeaGreenColor}" />
      <SolidColorBrush x:Key="ShallowsBrush" Color="{StaticResource ShallowsColor}" />
      <SolidColorBrush x:Key="QuayBrush" Color="{StaticResource QuayColor}" />
      <SolidColorBrush x:Key="QuayEdgeBrush" Color="{StaticResource QuayEdgeColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="AmberDeepBrush" Color="{StaticResource AmberDeepColor}" />
      <SolidColorBrush x:Key="HarbourStageBrush" Color="{StaticResource HarbourStageColor}" />
      <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
      <SolidColorBrush x:Key="OrangeInkBrush" Color="{StaticResource OrangeInkColor}" />
      <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
      <SolidColorBrush x:Key="SeaGreenInkBrush" Color="{StaticResource SeaGreenInkColor}" />
      <SolidColorBrush x:Key="AlertBrush" Color="{StaticResource AlertColor}" />
      <SolidColorBrush x:Key="AlertInkBrush" Color="{StaticResource AlertInkColor}" />
      <SolidColorBrush x:Key="RestrictedBrush" Color="{StaticResource RestrictedColor}" />
      <SolidColorBrush x:Key="HullBrush" Color="{StaticResource HullColor}" />
      <SolidColorBrush x:Key="BootToppingBrush" Color="{StaticResource BootToppingColor}" />
      <SolidColorBrush x:Key="BridgeBrush" Color="{StaticResource BridgeColor}" />
      <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
      <SolidColorBrush x:Key="SeaFlatBrush" Color="{StaticResource SeaFlatColor}" />
      <SolidColorBrush x:Key="RiverBankBrush" Color="{StaticResource RiverBankColor}" />
      <!-- Water-level charts share the river map's water: the deep water as the line, a fade below it -->
      <SolidColorBrush x:Key="WaterLineBrush" Color="{StaticResource RiverDeepColor}" />
      <SolidColorBrush x:Key="RiverEdgeBrush" Color="{StaticResource RiverEdgeColor}" />
      <!-- Hairlines: the design leans on 8-18% ink rules rather than boxes (light ink rules on Dark) -->
      <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource InkColor}" Opacity="0.08" />
      <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource InkColor}" Opacity="0.18" />
      <!-- A berth reserved for an arrival: the map polygon and its Key swatch -->
      <SolidColorBrush x:Key="ReservedFillBrush" Color="{StaticResource AccentColor}" Opacity="0.12" />
      <!-- The tide lane's area: water at 30% fading to 4% -->
      <SolidColorBrush x:Key="TideFillTopBrush" Color="{StaticResource WaterColor}" Opacity="0.3" />
      <SolidColorBrush x:Key="TideFillBottomBrush" Color="{StaticResource WaterColor}" Opacity="0.04" />
      <!-- Ahead of now: the timeline's future shade and its legend swatch -->
      <SolidColorBrush x:Key="AheadShadeBrush" Color="{StaticResource InkColor}" Opacity="0.03" />
      <!-- The NEEDS ACTION chip's ground: alert at 12% -->
      <SolidColorBrush x:Key="AlertChipBrush" Color="{StaticResource AlertColor}" Opacity="0.12" />
      <!-- The header tab's hover underline -->
      <SolidColorBrush x:Key="TabHoverBrush" Color="{StaticResource InkColor}" Opacity="0.16" />
      <!-- Toolkit card lightweight keys (every card is a PanelCard or OutlinedPanel): the surface, also under the pointer, because the panels are static and a hover tint would read as clickable -->
      <SolidColorBrush x:Key="ElevatedCardContentBackground" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="OutlinedCardContentBackground" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="CardContentBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
      <!-- The water-level charts' fade under the line -->
      <LinearGradientBrush x:Key="WaterFadeBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.34">
        <GradientStop Offset="0" Color="{StaticResource RiverDeepColor}" />
        <GradientStop Offset="1" Color="{StaticResource RiverDeepClearColor}" />
      </LinearGradientBrush>
    </ResourceDictionary>

