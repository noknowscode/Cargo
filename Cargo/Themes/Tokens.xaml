  <Color x:Key="ScanAnomalyColor">#FFFF4D4D</Color>

  <!-- Invariant brushes keep a name that says so: *InvariantBrush, or *OnDark* for the marks on a dark ground -->
  <SolidColorBrush x:Key="InkDeepInvariantBrush" Color="{StaticResource InkDeepColor}" />
  <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="{StaticResource TextOnDarkMutedColor}" />
  <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />
  <SolidColorBrush x:Key="TextOnDarkStrongBrush" Color="{StaticResource TextOnDarkStrongColor}" />
  <SolidColorBrush x:Key="AccentBrightInvariantBrush" Color="{StaticResource AccentBrightColor}" />
  <SolidColorBrush x:Key="AccentPaleInvariantBrush" Color="{StaticResource AccentPaleColor}" />
  <SolidColorBrush x:Key="DeckWhiteInvariantBrush" Color="{StaticResource DeckWhiteColor}" />
  <SolidColorBrush x:Key="CargoStandardInvariantBrush" Color="{StaticResource CargoStandardColor}" />
  <SolidColorBrush x:Key="CargoReeferInvariantBrush" Color="{StaticResource CargoReeferColor}" />
  <SolidColorBrush x:Key="CargoHazardInvariantBrush" Color="{StaticResource CargoHazardColor}" />
  <SolidColorBrush x:Key="CargoOversizeInvariantBrush" Color="{StaticResource CargoOversizeColor}" />
