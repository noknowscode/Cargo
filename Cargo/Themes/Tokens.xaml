<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Westhaven Dispatch — design tokens
       Palette from "A · One timeline (v6)" (docs/design/overview-timeline/EXTRACTION.md §1);
       harbour plant and cargo classes kept from "Quay Port v4".
       Nothing in the app hardcodes a colour; everything resolves here.

       Two themes, one identity. Light is the design's palette, unchanged. Dark is the same
       dispatch desk at night: a blue-black page with surfaces stepping up in lightness, ink
       turned to a cool off-white, the three blues re-spaced so Accent, Water and Navy stay
       apart (Water deepest, Accent brightest-saturated, Navy palest), status inks re-picked
       for a dark ground, and the 3D harbour lit for night (dark ground and water, the same
       paint under a lower light). Every text colour holds >= 4.5:1 on the grounds it is set on.

       Pages and styles use {ThemeResource} for every themed brush. Code resolves tokens for
       the window's theme through Domain/Tokens, which recolours the brushes it handed out and
       raises ThemeChanged so canvas and Skia scenes re-read (see Controls/Live.cs).
       "Default" is the Dark dictionary (the WinUI convention, so High Contrast falls back to it).

       Renamed for the Dark theme (2026-11-02): every themed brush was "*InvariantBrush" and is
       now "*Brush" (InkInvariantBrush -> InkBrush, HarbourStageInvariantBrush -> HarbourStageBrush,
       WaterFadeInvariantBrush -> WaterFadeBrush, and so on). Brushes that really are invariant
       keep the suffix: InkDeep, AccentBright, AccentPale, DeckWhite, the four cargo classes and
       PageDim; the *OnDark* brushes keep theirs. New: TextInverseMuted, TextOnDarkStrong,
       ShadowColor, ShadowRingColor, HarbourLightLevel, HarbourEdgeLift.
       ============================================================ -->

  <ResourceDictionary.ThemeDictionaries>
    <!-- ===== Light: the design's daylight palette ===== -->
    <ResourceDictionary x:Key="Light">

      <!-- Neutrals -->
      <!-- Text and marks; also the ground of inverse chips (primary button, NOW pill, filter on) -->
      <Color x:Key="InkColor">#FF121617</Color>
      <Color x:Key="InkRaisedColor">#FF1F2629</Color>
      <!-- Ground: the page behind every panel -->
      <Color x:Key="PaperColor">#FFF3F3F1</Color>
      <Color x:Key="PaperWarmColor">#FFF3F2EE</Color>
      <!-- Surface: header, panels, light tags, HUD floats, popovers -->
      <Color x:Key="SurfaceColor">#FFFBFBFA</Color>
      <!-- Ghost buttons. Dark lifts it above the surface so it still reads as a control -->
      <Color x:Key="SurfaceSunkColor">#FFF0F0ED</Color>
      <Color x:Key="SurfaceSunkAltColor">#FFE9EAE6</Color>
      <Color x:Key="LandColor">#FFE6E7E2</Color>
      <Color x:Key="RoadColor">#FFDDD7CA</Color>
      <!-- Secondary text. Light: muted 5.3:1, faint 4.9:1 on Paper (4.8 on SurfaceSunk). Dark: muted 7.3:1, faint 5.6:1 on Surface.
           Faint was #6B7377 (4.35:1 on Paper) until B2 -->
      <Color x:Key="TextMutedColor">#FF5E6569</Color>
      <Color x:Key="TextFaintColor">#FF636B6F</Color>
      <!-- Secondary text on an inverse (Ink) chip: the harbour's arrival tag -->
      <Color x:Key="TextInverseMutedColor">#FFC9CED1</Color>

      <!-- Brand / harbour -->
      <!-- Accent: active tab, primary button, focus ring, links, reserved berth, approach route, MOVES lane. Dark 7.5:1 on Surface -->
      <Color x:Key="AccentColor">#FF1C6E9E</Color>
      <!-- Emphasis accent for text (greeting name, arriving count): deeper on Light, lighter on Dark -->
      <Color x:Key="AccentDarkColor">#FF155A82</Color>
      <!-- Text and marks on Accent and AlertInk grounds (avatar, primary button, count badge): 8.0:1 on Dark -->
      <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
      <!-- Navy: vessel / happened (filled markers, hulls, cargo in). Dark keeps it the palest blue, apart from Accent and Water -->
      <Color x:Key="NavyColor">#FF0F4A6E</Color>
      <!-- Water: tide, cargo out, waterline and wake. Dark keeps it the deepest of the three blues -->
      <Color x:Key="WaterColor">#FF5598C4</Color>
      <Color x:Key="SeaGreenColor">#FF1E8F7A</Color>
      <Color x:Key="ShallowsColor">#FFCBDCE5</Color>
      <Color x:Key="QuayColor">#FF5F6B76</Color>
      <Color x:Key="QuayEdgeColor">#FF2C3944</Color>

      <!-- Status -->
      <Color x:Key="AmberColor">#FFE0A72F</Color>
      <Color x:Key="AmberDeepColor">#FFC9A227</Color>
      <Color x:Key="OrangeColor">#FFD9822B</Color>
      <!-- Ink variants: status colours set as text (Light >= 4.9:1 on Paper, Dark >= 7:1 on Surface) -->
      <Color x:Key="OrangeInkColor">#FF9A5212</Color>
      <Color x:Key="AmberInkColor">#FF8A6307</Color>
      <Color x:Key="SeaGreenInkColor">#FF146B5B</Color>
      <!-- Alert: needs-you marks and icons; AlertInk for needs-you text, late text and the count badge -->
