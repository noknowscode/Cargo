<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Westhaven Dispatch type: display Bricolage Grotesque, UI text Archivo, figures IBM Plex Mono.
       Colours are the theme's: the palette is Styles/ColorPaletteOverride.xaml, the no-role colours App.xaml. -->
  <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/BricolageGrotesque_SemiBold.ttf#Bricolage Grotesque SemiBold</FontFamily>
  <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Archivo_Regular.ttf#Archivo</FontFamily>
  <FontFamily x:Key="BodyMediumFont">ms-appx:///Assets/Fonts/Archivo_Medium.ttf#Archivo Medium</FontFamily>
  <FontFamily x:Key="BodyStrongFont">ms-appx:///Assets/Fonts/Archivo_SemiBold.ttf#Archivo SemiBold</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/IBMPlexMono_Regular.ttf#IBM Plex Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFont">ms-appx:///Assets/Fonts/IBMPlexMono_Medium.ttf#IBM Plex Mono Medium</FontFamily>

</ResourceDictionary>
