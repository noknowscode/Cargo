<UserControl x:Class="Cargo.Controls.Harbour.HarbourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:harbour="using:Cargo.Controls.Harbour"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:presentation="using:Cargo.Presentation"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             IsTabStop="True"
             UseSystemFocusVisuals="True"
             AutomationProperties.Name="Harbour map. Arrow keys orbit, plus and minus zoom, zero resets.">

  <UserControl.Resources>
    <!-- A vessel's data tag: the name and one status line. A selected vessel's facts open in the docked card
         (FactsCard), not on the tag: stacked above the chip they pushed it down over the ship it named -->
    <DataTemplate x:Key="HarbourTagTemplate" x:DataType="presentation:HarbourTag">
      <StackPanel Spacing="{StaticResource Space050}">

        <Button Style="{StaticResource BareButton}" Command="{x:Bind Toggle}" CommandParameter="{x:Bind Id}"
                controls:HoverLink.Command="{x:Bind Hover}" controls:HoverLink.Key="{x:Bind Id}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" HorizontalAlignment="Center">
          <Grid>
            <!-- Light tag: name and status on one 30 px line, on the float shadow.
                 Shadows inline: a Style-supplied collection never applies (Toolkit gotcha G36). -->
            <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" Visibility="{x:Bind harbour:HarbourView.LightTag(IsPending), Mode=OneWay}">
              <utu:ShadowContainer.Shadows>
                <utu:ShadowCollection>
                  <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
                  <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
                  <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.07" />
                </utu:ShadowCollection>
              </utu:ShadowContainer.Shadows>
              <!-- xaml-lint: allow card - a data-tag chip on a leader line, not a content card -->
              <Border CornerRadius="{StaticResource Radius200CornerRadius}" Height="30" Padding="{StaticResource Space125HorizontalThickness}"
                      BorderBrush="{x:Bind harbour:HarbourView.TagEdge(IsSelected, IsLit), Mode=OneWay}" BorderThickness="{x:Bind harbour:HarbourView.TagEdgeWidth(IsSelected), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource TypeStrong13}" Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Text="{x:Bind Sub, Mode=OneWay}" Style="{StaticResource TypeMono12}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>
            </utu:ShadowContainer>

            <!-- Inverse tag (ink ground: dark on Light, light on Dark): the arrival waiting on its berth, with the time to go -->
            <utu:ShadowContainer Background="{ThemeResource SurfaceInverseBrush}" Visibility="{x:Bind harbour:HarbourView.DarkTag(IsPending), Mode=OneWay}">
              <utu:ShadowContainer.Shadows>
                <utu:ShadowCollection>
                  <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.18" />
                </utu:ShadowCollection>
              </utu:ShadowContainer.Shadows>
              <!-- xaml-lint: allow card - a data-tag chip on a leader line, not a content card -->
              <Border CornerRadius="{StaticResource Radius200CornerRadius}" Padding="{StaticResource Inset12x8}"
                      BorderBrush="{x:Bind harbour:HarbourView.TagEdge(IsSelected, IsLit), Mode=OneWay}" BorderThickness="{x:Bind harbour:HarbourView.TagEdgeWidth(IsSelected), Mode=OneWay}">
                <StackPanel Spacing="{StaticResource Space050}">
                  <Grid ColumnSpacing="{StaticResource Space200}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource TypeStrong13}" Foreground="{ThemeResource OnSurfaceInverseBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Countdown, Mode=OneWay}" Style="{StaticResource TypeMonoMedium12}"
                               Foreground="{ThemeResource OnSurfaceInverseBrush}" />
                  </Grid>
                  <TextBlock Text="{x:Bind PendingSub, Mode=OneWay}" Style="{StaticResource TypeMono12}" Foreground="{ThemeResource OnSurfaceInverseMediumBrush}" />
                </StackPanel>
              </Border>
            </utu:ShadowContainer>
          </Grid>
        </Button>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{ThemeResource HarbourStageBrush}">
    <Border x:Name="SceneHost" Background="Transparent" />

    <Canvas x:Name="TagLayer" />

    <!-- The selected vessel's facts, docked bottom-right above the HUD: the camera centres the vessel, so the
         card never covers it. Fades and rises in (Reveal); short frames (the mini band, a section's strip) skip it -->
    <utu:CardContentControl AutomationProperties.Name="Selected vessel facts" x:Name="FactsCard" Style="{StaticResource PanelCard}" CornerRadius="{StaticResource Radius200CornerRadius}" Padding="14,12" Width="280"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="{utu:Responsive Narrowest='0,0,16,64', Narrow='0,0,40,72'}"
                            Visibility="Collapsed" Opacity="0"
                            controls:Reveal.IsOn="{x:Bind ViewModel.HasSelectedTag, Mode=OneWay}" controls:Reveal.Hides="True" controls:Reveal.Rise="6">
      <utu:CardContentControl.RenderTransform>
        <TranslateTransform />
      </utu:CardContentControl.RenderTransform>
      <StackPanel Spacing="{StaticResource Space150}">
        <StackPanel Spacing="{StaticResource Space025}">
          <TextBlock Text="{x:Bind ViewModel.SelectedTag.Name, Mode=OneWay}" Style="{StaticResource TitleText}" />
          <TextBlock Text="{x:Bind ViewModel.SelectedLine, Mode=OneWay}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl IsTabStop="False" AutomationProperties.Name="Vessel facts" ItemsSource="{x:Bind ViewModel.SelectedTag.Facts, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:TwoColumnPanel ColumnSpacing="{StaticResource Space200}" RowSpacing="{StaticResource Space100}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="presentation:Fact">
              <StackPanel Spacing="{StaticResource Space025}">
                <TextBlock Text="{x:Bind Key}" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongSmallText}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button AutomationProperties.Name="Open vessel profile" Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.SelectedTag.Open, Mode=OneWay}"
                CommandParameter="{x:Bind ViewModel.SelectedTag.Id, Mode=OneWay}" Content="Open vessel profile →" HorizontalAlignment="Stretch" />
      </StackPanel>
    </utu:CardContentControl>

    <!-- Screen-reader summary (HarbourViewModel.Summary): present to automation, invisible on screen -->
    <TextBlock x:Name="Summary" Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
               HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" />

    <!-- HUD floats: surface on the float shadow. The shadow collection is repeated on each
         container because a Style-supplied one never applies (Toolkit gotcha G36). -->

    <!-- Camera: the current preset, opening the four presets upward; a drag or zoom clears the check -->
    <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" Visibility="{x:Bind harbour:HarbourView.Hud(ViewModel.Tight), Mode=OneWay}"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{utu:Responsive Narrowest='16,0,0,12', Narrow='40,0,0,16'}">
      <utu:ShadowContainer.Shadows>
        <utu:ShadowCollection>
          <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
          <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
          <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.07" />
        </utu:ShadowCollection>
      </utu:ShadowContainer.Shadows>
      <Button Style="{StaticResource HudSummaryButton}" AutomationProperties.Name="Camera view">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
          <TextBlock x:Name="CameraLabel" Text="Overview" Style="{StaticResource LabelLarge}" VerticalAlignment="Center" />
          <Viewbox Width="16" Height="16" VerticalAlignment="Center">
            <Grid Width="24" Height="24">
              <shapes:Path Style="{StaticResource ChevronDownIcon}" Stroke="{ThemeResource OnSurfaceBrush}" />
            </Grid>
          </Viewbox>
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="Top">
            <RadioMenuFlyoutItem x:Name="OverviewItem" Text="Overview" GroupName="Camera" IsChecked="True" Command="{x:Bind ViewCommand}" CommandParameter="overview" />
            <RadioMenuFlyoutItem x:Name="SeaItem" Text="From sea" GroupName="Camera" Command="{x:Bind ViewCommand}" CommandParameter="sea" />
            <RadioMenuFlyoutItem x:Name="LandItem" Text="From land" GroupName="Camera" Command="{x:Bind ViewCommand}" CommandParameter="land" />
            <RadioMenuFlyoutItem x:Name="PlanItem" Text="Plan" GroupName="Camera" Command="{x:Bind ViewCommand}" CommandParameter="plan" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </utu:ShadowContainer>

    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{utu:Responsive Narrowest='0,0,16,12', Narrow='0,0,40,16'}"
                Visibility="{x:Bind harbour:HarbourView.Hud(ViewModel.Tight), Mode=OneWay}">
      <!-- Key: what each mark on the map means -->
      <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}">
        <utu:ShadowContainer.Shadows>
          <utu:ShadowCollection>
            <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
            <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
            <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.07" />
          </utu:ShadowCollection>
        </utu:ShadowContainer.Shadows>
        <Button Style="{StaticResource HudSummaryButton}" Content="Key" AutomationProperties.Name="Map key">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <StackPanel MinWidth="208">
                <TextBlock Text="KEY" Style="{StaticResource CapsLabelText}" Margin="10,8,10,4" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}" Padding="{StaticResource Space125Thickness}">
                  <Ellipse Width="9" Height="9" Fill="{ThemeResource NavyBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Vessel alongside" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}" Padding="{StaticResource Space125Thickness}">
                  <Ellipse Width="9" Height="9" Stroke="{ThemeResource NavyBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
                  <TextBlock Text="Vessel inbound" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}" Padding="{StaticResource Space125Thickness}">
                  <Rectangle Width="14" Height="12" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource PrimaryContainerBrush}" Stroke="{ThemeResource PrimaryBrush}" StrokeThickness="1.5" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                  <TextBlock Text="Berth reserved for an arrival" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}" Padding="{StaticResource Space125Thickness}">
                  <Rectangle Width="14" Height="12" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource OutlineVariantBrush}" Stroke="{ThemeResource OnSurfaceVariantBrush}" StrokeThickness="1.5" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                  <TextBlock Text="Restricted" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space125}" Padding="{StaticResource Space125Thickness}">
                  <Line X1="0" Y1="0" X2="14" Y2="0" Width="14" Stroke="{ThemeResource OnSurfaceVariantBrush}" StrokeThickness="1.5" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                  <TextBlock Text="Depth contour, metres" Style="{StaticResource KeyRowText}" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </utu:ShadowContainer>

      <!-- Scale, north, zoom: one float, cells split by hairlines. Phones pinch instead, and the row has no
           room for it beside the camera menu -->
      <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}">
        <utu:ShadowContainer.Shadows>
          <utu:ShadowCollection>
            <utu:Shadow Spread="1" BlurRadius="0" Color="{ThemeResource OnSurfaceColor}" Opacity="0.08" />
            <utu:Shadow OffsetY="1" BlurRadius="2" Color="{ThemeResource ShadowColor}" Opacity="0.06" />
            <utu:Shadow OffsetY="6" BlurRadius="20" Color="{ThemeResource ShadowColor}" Opacity="0.07" />
          </utu:ShadowCollection>
        </utu:ShadowContainer.Shadows>
        <Grid CornerRadius="{StaticResource Radius200CornerRadius}" Height="44">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" Padding="14,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border x:Name="ScaleBar" Height="6" Width="64" VerticalAlignment="Center"
                    BorderBrush="{ThemeResource OnSurfaceBrush}" BorderThickness="1.5,0,1.5,1.5" />
            <TextBlock x:Name="ScaleLabel" Text="250 m" Style="{StaticResource TypeMonoMedium12}"
                       Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Rectangle Grid.Column="1" Fill="{ThemeResource OutlineVariantBrush}" />
          <Viewbox Grid.Column="2" Width="20" Height="20" IsHitTestVisible="False" AutomationProperties.Name="North">
            <Canvas Width="26" Height="26">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="Needle" CenterX="13" CenterY="13" />
              </Canvas.RenderTransform>
              <shapes:Path Style="{StaticResource NorthNeedleIcon}" Fill="{ThemeResource ErrorBrush}" />
              <shapes:Path Style="{StaticResource SouthNeedleIcon}" Fill="{ThemeResource OutlineBrush}" />
            </Canvas>
          </Viewbox>
          <Rectangle Grid.Column="3" Fill="{ThemeResource OutlineVariantBrush}" />
          <Button Grid.Column="4" Style="{StaticResource HudIconButton}" Command="{x:Bind ZoomCommand}" CommandParameter="out"
                  AutomationProperties.Name="Zoom out">
            <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{StaticResource MinusIcon}" Stroke="{ThemeResource OnSurfaceBrush}" />
              </Grid>
            </Viewbox>
          </Button>
          <Rectangle Grid.Column="5" Fill="{ThemeResource OutlineVariantBrush}" />
          <Button Grid.Column="6" Style="{StaticResource HudIconButton}" Command="{x:Bind ZoomCommand}" CommandParameter="in"
                  AutomationProperties.Name="Zoom in">
            <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{StaticResource PlusIcon}" Stroke="{ThemeResource OnSurfaceBrush}" />
              </Grid>
            </Viewbox>
          </Button>
        </Grid>
      </utu:ShadowContainer>
    </StackPanel>
  </Grid>
</UserControl>
