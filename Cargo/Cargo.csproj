<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Montreal Port Authority</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.westhaven.cargo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Montreal Port Authority</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Montreal Port Authority operations dispatch, powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Navigation;
      Toolkit;
      Skia;
      Logging;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Overview tide lane: the Liveline chart, vendored from noknowscode/uno-lab (see Liveline/). -->
    <ProjectReference Include="..\Liveline\Liveline.csproj" />
  </ItemGroup>

</Project>
