<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Uno.Sdk skips the heads the build OS can't build (iOS on Linux, Windows off Windows). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:CargoTargetFrameworks=net10.0-desktop.
      Liveline follows it, so a single-head build restores no other head (and needs no other workload).
    -->
    <TargetFrameworks Condition="'$(CargoTargetFrameworks)' != ''">$(CargoTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Westhaven Port Authority</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.westhaven.cargo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Westhaven Port Authority</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Westhaven Port Authority operations dispatch (a fictional port), powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Navigation;
      Toolkit;
      Skia;
      Logging;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
    <!--
      Uno.Sdk 7.0.0-dev.115 bundles Hot Design 2.0.0-dev.31 and App MCP 2.0.0-dev.18, whose clients still reference
      Uno.UI.Lottie, an assembly Uno 7 no longer ships: every Debug launch crashes in GlobalStaticResources. Both stay off
      (Debug only; Release never had them) until a dev build drops the reference. Delete these three lines then.
    -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <DefineConstants>$(DefineConstants);NO_UNO_STUDIO</DefineConstants>
  </PropertyGroup>

  <!--
    WinAppSDK: SKCanvasElement (the harbour, the timeline lanes, the ship glyphs, Liveline) needs an x64 or ARM64
    build, never AnyCPU. Uno 7's WinUI libraries are built against WinRT.Runtime 2.3.1; the SDK's default projection
    for 19041 (Microsoft.Windows.SDK.NET.Ref 10.0.19041.57) carries 2.2.0 and fails with CS1705, so pin one that matches.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Overview tide lane: the Liveline chart, vendored from noknowscode/uno-lab (see Liveline/). -->
    <ProjectReference Include="..\Liveline\Liveline.csproj" />
  </ItemGroup>

</Project>
