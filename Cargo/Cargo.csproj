<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!--
      Uno.Sdk skips the heads the build OS can't build (iOS on Linux). Plain net10.0 is not a head:
      Cargo.Tests references it for the domain and view-model logic, and it never starts the Uno runtime.
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop;net10.0</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:CargoTargetFrameworks=net10.0-desktop.
      Liveline follows it, so a single-head build restores no other head (and needs no other workload). The tests
      run with -p:CargoTargetFrameworks=net10.0. A global -p:TargetFrameworks would retarget the test project too.
    -->
    <TargetFrameworks Condition="'$(CargoTargetFrameworks)' != ''">$(CargoTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Westhaven Port Authority</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.westhaven.cargo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Westhaven Port Authority</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Westhaven Port Authority operations dispatch (a fictional port), powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Navigation;
      Toolkit;
      Skia;
      Logging;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Overview tide lane: the Liveline chart, vendored from noknowscode/uno-lab (see Liveline/). -->
    <ProjectReference Include="..\Liveline\Liveline.csproj" />
  </ItemGroup>

</Project>
