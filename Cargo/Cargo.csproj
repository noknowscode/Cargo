<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Uno.Sdk skips the heads the build OS can't build (iOS on Linux). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!-- One head at a time (CI, RID-specific publish): -p:CargoTargetFrameworks=net10.0-desktop. -->
    <TargetFrameworks Condition="'$(CargoTargetFrameworks)' != ''">$(CargoTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Westhaven Port Authority</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.westhaven.cargo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Westhaven Port Authority</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Westhaven Port Authority operations dispatch (a fictional port), powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Navigation;
      Toolkit;
      Skia;
      Logging;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
