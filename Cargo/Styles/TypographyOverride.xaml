<!--
  Westhaven Dispatch: the type scale. The Simple theme reads it through App.xaml (SimpleToolkitTheme.FontOverrideSource)
  on top of DefaultFontFamily (Archivo, set on the theme), so every semantic text style (DisplayLarge ... CaptionSmall),
  the theme's controls and the app's text styles take the design's sizes, weights and families from here.

  The design's ramp (docs/design/overview-timeline/EXTRACTION.md §1 Fonts) is 11 12 13 14 15 18 20 24 30 40, plus the
  wordmark at 19. Display type is Bricolage Grotesque (SemiBold only), UI text Archivo (Regular 400, Medium 500,
  SemiBold 600) and every figure that has to line up in a column IBM Plex Mono (Regular, Medium). Archivo and Plex Mono
  ship as static faces; a font manifest beside each regular face (Assets/Fonts/*.ttf.manifest) maps FontWeight to
  the face, so one family plus a weight picks the right file.

    Style            Size  Weight    Family     Used for
    DisplayLarge     40    SemiBold  Bricolage  the greeting, page titles
    DisplayMedium    30    SemiBold  Bricolage  a detail panel's figure
    DisplaySmall     24    SemiBold  Bricolage  section heads
    HeadlineLarge    30    SemiBold  Archivo    headline figures
    HeadlineMedium   20    SemiBold  Archivo    lane and card figures
    HeadlineSmall    19    SemiBold  Bricolage  the wordmark
    TitleLarge       18    SemiBold  Archivo    panel headings
    TitleMedium      15    SemiBold  Archivo    titles, list names
    TitleSmall       14    SemiBold  Archivo    panel titles, names
    BodyLarge        15    Regular   Archivo    the date line
    BodyMedium       13    Regular   Archivo    body text
    BodySmall        12    Regular   Archivo    captions, fact keys
    LabelLarge       14    Medium    Archivo    labels, the theme's buttons
    LabelMedium      13    Medium    Archivo    button labels, strong body
    LabelSmall       12    Medium    Archivo    status words, chips
    LabelExtraSmall  11    Medium    Archivo    tags, lane keys
    CaptionLarge     14    Regular   Archivo    lead text, page subtitles
    CaptionMedium    12    Regular   Archivo    (as BodySmall)
    CaptionSmall     11    Regular   Archivo    micro text
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The design's two other families. Pages and styles take them through the app's text styles (Themes/Styles.xaml) -->
  <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/BricolageGrotesque_SemiBold.ttf#Bricolage Grotesque SemiBold</FontFamily>
  <FontFamily x:Key="MonoFontFamily">ms-appx:///Assets/Fonts/IBMPlexMono_Regular.ttf#IBM Plex Mono</FontFamily>

  <StaticResource x:Key="DisplayLargeFontFamily" ResourceKey="DisplayFontFamily" />
  <x:Double x:Key="DisplayLargeFontSize">40</x:Double>
  <x:String x:Key="DisplayLargeFontWeight">SemiBold</x:String>
  <StaticResource x:Key="DisplayMediumFontFamily" ResourceKey="DisplayFontFamily" />
  <x:Double x:Key="DisplayMediumFontSize">30</x:Double>
  <x:String x:Key="DisplayMediumFontWeight">SemiBold</x:String>
  <StaticResource x:Key="DisplaySmallFontFamily" ResourceKey="DisplayFontFamily" />
  <x:Double x:Key="DisplaySmallFontSize">24</x:Double>
  <x:String x:Key="DisplaySmallFontWeight">SemiBold</x:String>

  <x:Double x:Key="HeadlineLargeFontSize">30</x:Double>
  <x:String x:Key="HeadlineLargeFontWeight">SemiBold</x:String>
  <x:Double x:Key="HeadlineMediumFontSize">20</x:Double>
  <x:String x:Key="HeadlineMediumFontWeight">SemiBold</x:String>
  <StaticResource x:Key="HeadlineSmallFontFamily" ResourceKey="DisplayFontFamily" />
  <x:Double x:Key="HeadlineSmallFontSize">19</x:Double>
  <x:String x:Key="HeadlineSmallFontWeight">SemiBold</x:String>

  <x:Double x:Key="TitleLargeFontSize">18</x:Double>
  <x:String x:Key="TitleLargeFontWeight">SemiBold</x:String>
  <x:Double x:Key="TitleMediumFontSize">15</x:Double>
  <x:String x:Key="TitleMediumFontWeight">SemiBold</x:String>
  <x:Double x:Key="TitleSmallFontSize">14</x:Double>
  <x:String x:Key="TitleSmallFontWeight">SemiBold</x:String>

  <x:Double x:Key="BodyLargeFontSize">15</x:Double>
  <x:String x:Key="BodyLargeFontWeight">Normal</x:String>
  <x:Double x:Key="BodyMediumFontSize">13</x:Double>
  <x:String x:Key="BodyMediumFontWeight">Normal</x:String>
  <x:Double x:Key="BodySmallFontSize">12</x:Double>
  <x:String x:Key="BodySmallFontWeight">Normal</x:String>

  <x:Double x:Key="LabelLargeFontSize">14</x:Double>
  <x:String x:Key="LabelLargeFontWeight">Medium</x:String>
  <x:Double x:Key="LabelMediumFontSize">13</x:Double>
  <x:String x:Key="LabelMediumFontWeight">Medium</x:String>
  <x:Double x:Key="LabelSmallFontSize">12</x:Double>
  <x:String x:Key="LabelSmallFontWeight">Medium</x:String>
  <x:Double x:Key="LabelExtraSmallFontSize">11</x:Double>
  <x:String x:Key="LabelExtraSmallFontWeight">Medium</x:String>

  <x:Double x:Key="CaptionLargeFontSize">14</x:Double>
  <x:String x:Key="CaptionLargeFontWeight">Normal</x:String>
  <x:Double x:Key="CaptionMediumFontSize">12</x:Double>
  <x:String x:Key="CaptionMediumFontWeight">Normal</x:String>
  <x:Double x:Key="CaptionSmallFontSize">11</x:Double>
  <x:String x:Key="CaptionSmallFontWeight">Normal</x:String>

</ResourceDictionary>
