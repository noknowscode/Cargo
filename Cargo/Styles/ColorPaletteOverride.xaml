      <Color x:Key="ErrorColor">#FFF08C72</Color>
      <Color x:Key="OnErrorColor">#FF0B1820</Color>
      <Color x:Key="ErrorContainerColor">#FF302626</Color>
      <Color x:Key="OnErrorContainerColor">#FFF08C72</Color>

      <Color x:Key="BackgroundColor">#FF0F1315</Color>
      <Color x:Key="OnBackgroundColor">#FFE6EAEC</Color>

      <Color x:Key="SurfaceColor">#FF181D20</Color>
      <Color x:Key="OnSurfaceColor">#FFE6EAEC</Color>
      <Color x:Key="SurfaceVariantColor">#FF20272A</Color>
      <Color x:Key="OnSurfaceVariantColor">#FFA1ABB0</Color>
      <Color x:Key="SurfaceInverseColor">#FFE6EAEC</Color>
      <Color x:Key="OnSurfaceInverseColor">#FF0F1315</Color>
      <Color x:Key="SurfaceTintColor">#FF6CB4E4</Color>

      <Color x:Key="OutlineColor">#2EE6EAEC</Color>
      <Color x:Key="OutlineVariantColor">#14E6EAEC</Color>
      <Color x:Key="ShadowColor">#FF121617</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
